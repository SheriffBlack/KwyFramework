<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kwy.Communicate.Abstractions\Kwy.Communicate.Abstractions.csproj" />
    <ProjectReference Include="..\Kwy.Communicate.Core\Kwy.Communicate.Core.csproj" />
  </ItemGroup>

  <Choose>
	<When Condition="'$(TargetFramework)' == 'net8.0'">
	  <ItemGroup>
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
		  </ItemGroup>
	</When>
	<When Condition="'$(TargetFramework)' == 'net10.0'">
	  <ItemGroup>
		<PackageReference Include="System.IO.Ports" Version="10.0.1" />
	  </ItemGroup>
	</When>
  </Choose>
</Project>
