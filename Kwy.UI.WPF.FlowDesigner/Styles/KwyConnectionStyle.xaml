<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.FlowDesigner.Controls">


    <Style TargetType="{x:Type controls:KwyConnection}">
        <Setter Property="Stroke" Value="{DynamicResource KwyFlowDesignerConnectionBrush}" />
        <!--  VM Orange  -->
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="ArrowSize" Value="6" />
        <Setter Property="ArrowWidth" Value="4" />
        <Setter Property="HubOffset" Value="5.0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="OrthogonalMargin" Value="40" />
        <Setter Property="BezierDistance" Value="30" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyConnection}">
                    <Grid IsHitTestVisible="True">
                        <Path
                            Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}"
                            Stroke="Transparent"
                            StrokeThickness="10" />
                        <Path
                            x:Name="PART_Path"
                            Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="Transparent"
                            IsHitTestVisible="False"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />

                        <Canvas IsHitTestVisible="False">
                            <Path
                                x:Name="PART_Arrow"
                                Canvas.Left="{Binding AdjustedTarget.X, RelativeSource={RelativeSource TemplatedParent}}"
                                Canvas.Top="{Binding AdjustedTarget.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                Data="M 0,0 L -6,-4 L -6,4 Z"
                                Fill="{TemplateBinding Stroke}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetSide, RelativeSource={RelativeSource TemplatedParent}}" Value="Left">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TargetSide, RelativeSource={RelativeSource TemplatedParent}}" Value="Right">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TargetSide, RelativeSource={RelativeSource TemplatedParent}}" Value="Top">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TargetSide, RelativeSource={RelativeSource TemplatedParent}}" Value="Bottom">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Path" Property="Stroke" Value="{DynamicResource KwyFlowDesignerConnectionSelectedBrush}" />
                            <Setter TargetName="PART_Path" Property="StrokeThickness" Value="3" />
                            <Setter TargetName="PART_Arrow" Property="Fill" Value="{DynamicResource KwyFlowDesignerConnectionSelectedBrush}" />
                            <Setter TargetName="PART_Arrow" Property="Stroke" Value="{DynamicResource KwyFlowDesignerConnectionSelectedBrush}" />
                        </Trigger>
                        <!--  箭头旋转逻辑移至 Path.Style 内部  -->
                        <Trigger Property="PathData" Value="{x:Null}">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
