<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.FlowDesigner.Controls">



    <Style TargetType="{x:Type controls:KwyConnector}">
        <Setter Property="Background" Value="{DynamicResource KwyFlowDesignerConnectorBackgroundBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="{Binding Name, FallbackValue='Pin'}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyConnector}">
                    <Grid
                        x:Name="PART_PortCircle"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Opacity="1">
                        <!--  1. Data 端口：VisionMaster 风格白底圆点  -->
                        <Ellipse
                            x:Name="DataCircle"
                            Width="8"
                            Height="8"
                            Fill="{TemplateBinding Background}"
                            Stroke="{DynamicResource KwyFlowDesignerConnectorBorderBrush}"
                            StrokeThickness="1"
                            Visibility="Visible" />

                        <!--  2. Execution 端口：VisionMaster 风格箭头 (放在圆圈内或独立)  -->
                        <Path
                            x:Name="ExecutionPath"
                            Width="8"
                            Height="8"
                            Data="M2,1 L7,4 L2,7 Z"
                            Fill="{TemplateBinding Background}"
                            Stretch="Uniform"
                            Stroke="{DynamicResource KwyFlowDesignerConnectorBorderBrush}"
                            StrokeThickness="1"
                            Visibility="Collapsed" />

                        <!--  辅助连线热区 (透明但可点击且足够大)  -->
                        <Ellipse Fill="Transparent" IsHitTestVisible="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  0. 端口类型切换  -->
                        <Trigger Property="PortType" Value="Execution">
                            <Setter TargetName="DataCircle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ExecutionPath" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  方向旋转逻辑  -->
                        <Trigger Property="Side" Value="Left">
                            <Setter TargetName="ExecutionPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Side" Value="Top">
                            <Setter TargetName="ExecutionPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Side" Value="Right">
                            <Setter TargetName="ExecutionPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Side" Value="Bottom">
                            <Setter TargetName="ExecutionPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--
                            如果是输入端口且在右侧（虽然逻辑上不常有），或者是普通右侧输出，箭头朝外。
                            这里我们根据 Side 和 Direction 综合微调。
                            默认路径 M0,0 L10,5 L0,10 是向右指。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Direction" Value="Input" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ExecutionPath" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </MultiTrigger>

                        <!--
                            左侧输入需要向右指(0deg)，右侧输出需要向右指(0deg)。
                            顶部输入需要向下指(90deg)，底部输出需要向下指(90deg)。
                            以上逻辑已在上面的 Side Trigger 中体现。
                        -->

                        <!--  2. 已连接状态：只有活跃引脚显示  -->
                        <DataTrigger Binding="{Binding IsActivePin, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_PortCircle" Property="Opacity" Value="1" />
                        </DataTrigger>

                        <!--  2. 已连接状态：填充端口主题颜色  -->
                        <Trigger Property="IsConnected" Value="True">
                            <Setter TargetName="DataCircle" Property="Stroke" Value="{Binding PortColor, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="DataCircle" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="ExecutionPath" Property="Stroke" Value="{Binding PortColor, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ExecutionPath" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="DataCircle" Property="Opacity" Value="1" />
                        </Trigger>

                        <!--  3. 鼠标物理悬停：高亮  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DataCircle" Property="Stroke" Value="{Binding PortColor, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ExecutionPath" Property="Stroke" Value="{Binding PortColor, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="DataCircle" Property="StrokeThickness" Value="2" />
                        </Trigger>

                        <!--  4. 父节点未悬停时：隐藏非连接引脚 (Ghost Mode / 幽灵效果)  -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyNode}}}" Value="False">
                            <Setter TargetName="PART_PortCircle" Property="Opacity" Value="0.0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyNode}}}" Value="False" />
                                <Condition Binding="{Binding IsConnected}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_PortCircle" Property="Opacity" Value="1" />
                        </MultiDataTrigger>

                        <!--  5. 正在连线中：引导用户，目标端强力显示  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsConnecting, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyEditor}}}" Value="True" />
                                <Condition Binding="{Binding Direction}" Value="Input" />
                                <Condition Binding="{Binding PendingSource.Direction, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyEditor}}}" Value="Output" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_PortCircle" Property="Opacity" Value="1" />
                            <Setter TargetName="DataCircle" Property="Stroke" Value="{Binding PortColor, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="DataCircle" Property="StrokeThickness" Value="2" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsConnecting, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyEditor}}}" Value="True" />
                                <Condition Binding="{Binding Direction}" Value="Output" />
                                <Condition Binding="{Binding PendingSource.Direction, RelativeSource={RelativeSource AncestorType={x:Type controls:KwyEditor}}}" Value="Input" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_PortCircle" Property="Opacity" Value="1" />
                            <Setter TargetName="DataCircle" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="ExecutionPath" Property="StrokeThickness" Value="2" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
