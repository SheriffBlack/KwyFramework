<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.FlowDesigner.Controls">




    <Style TargetType="{x:Type controls:KwyEditor}">
        <Setter Property="Background" Value="{DynamicResource KwyFlowDesignerEditorBackgroundBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyEditor}">
                    <Border
                        Background="{TemplateBinding Background}"
                        ContextMenu="{TemplateBinding ContextMenu}"
                        Focusable="True">

                        <Grid ClipToBounds="True">
                            <!--  包装层：应用缩放和偏移  -->
                            <Grid x:Name="PART_TransformationLayer">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ViewportScale, RelativeSource={RelativeSource TemplatedParent}}" ScaleY="{Binding ViewportScale, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <TranslateTransform X="{Binding ViewportOffset.X, RelativeSource={RelativeSource TemplatedParent}}" Y="{Binding ViewportOffset.Y, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!--  增加一个透明背景层，确保整个画布区域都能接收鼠标滾轮消息  -->
                                <Grid Background="Transparent" />

                                <!--  1. 连线层 (固定存在的连线)  -->
                                <ItemsControl
                                    Panel.ZIndex="0"
                                    ItemTemplate="{TemplateBinding ConnectionTemplate}"
                                    ItemsSource="{TemplateBinding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{x:Null}" IsHitTestVisible="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!--  2. 预览连线层 (拖拽时出现的虚线)  -->
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Panel.ZIndex="1"
                                    Content="{TemplateBinding PendingConnection}"
                                    ContentTemplate="{TemplateBinding PendingConnectionTemplate}"
                                    IsHitTestVisible="False" />

                                <!--  节点项集合容器  -->
                                <ItemsPresenter Panel.ZIndex="2" />

                                <!--  辅助对齐线 (垂直)  -->
                                <ItemsControl
                                    Panel.ZIndex="3"
                                    IsHitTestVisible="False"
                                    ItemsSource="{TemplateBinding VerticalGuideLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line
                                                Stroke="{DynamicResource KwyFlowDesignerGuideLineBrush}"
                                                StrokeDashArray="4 2"
                                                StrokeThickness="1"
                                                X1="{Binding}"
                                                X2="{Binding}"
                                                Y1="-10000"
                                                Y2="10000" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  辅助对齐线 (水平)  -->
                                <ItemsControl
                                    Panel.ZIndex="3"
                                    IsHitTestVisible="False"
                                    ItemsSource="{TemplateBinding HorizontalGuideLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line
                                                Stroke="{DynamicResource KwyFlowDesignerGuideLineBrush}"
                                                StrokeDashArray="4 2"
                                                StrokeThickness="1"
                                                X1="-10000"
                                                X2="10000"
                                                Y1="{Binding}"
                                                Y2="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas Background="{x:Null}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
