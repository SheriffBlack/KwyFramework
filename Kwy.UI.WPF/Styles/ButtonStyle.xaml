<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <Style
        x:Key="DefaultButtonStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="helpers:RippleEffectHelper.IsEnabled" Value="True" />
        <Setter Property="helpers:RippleEffectHelper.RippleBrush" Value="{DynamicResource RippleBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PART_ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid ClipToBounds="True">
                            <Canvas x:Name="PART_RippleCanvas" IsHitTestVisible="False" />
                            <ContentPresenter
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}" />
                            <Setter TargetName="PART_ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlFocusedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlFocusedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_ButtonBorder" Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="PART_ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="40" />
    </Style>

    <Style
        x:Key="ButtonCircleStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="30">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ButtonContentVerticalStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Margin="5" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding Path=(helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType=Button}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock Style="{StaticResource BtnVerticalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="44" Height="44">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource BtnVerticalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ButtonContentHorizontalStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="120" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding Path=(helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType=Button}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock FontSize="28" Style="{StaticResource BtnHorizontalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="28" Height="28">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Rectangle Grid.Column="1" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="16"
                            Style="{StaticResource BtnHorizontalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
