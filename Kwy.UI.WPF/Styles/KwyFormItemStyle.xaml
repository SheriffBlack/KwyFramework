<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:KwyFormItem}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!--  恢复为 Center，保证普通输入框高度自然  -->
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyFormItem}">
                    <Border
                        x:Name="PART_FormItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_LayoutRoot">
                            <Grid.ColumnDefinitions>
                                <!--  Label 列：使用 SharedSizeGroup 确保多行对齐  -->
                                <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}" SharedSizeGroup="LabelGroup" />
                                <!--  固定间距列：统一控制标签与控件的距离  -->
                                <ColumnDefinition Width="15" />
                                <!--  内容列：拉伸填充  -->
                                <ColumnDefinition Width="{Binding InputWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="PART_LabelBlock"
                                Grid.Column="0"
                                Margin="10,4,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource ControlTextBlockStyle}"
                                Text="{TemplateBinding Label}"
                                TextAlignment="Right" />

                            <ContentPresenter
                                x:Name="PART_Content"
                                Grid.Column="2"
                                Margin="30,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  布局方向调整  -->
                        <Trigger Property="LabelPosition" Value="Left">
                            <Setter TargetName="PART_LabelBlock" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_LabelBlock" Property="TextAlignment" Value="Left" />
                        </Trigger>
                        <!--  当 Label 为空时，隐藏标签列  -->
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="PART_LabelBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_LabelBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!--  如果用户显式设置了 VerticalAlignment="Stretch"，则内部也跟着拉伸  -->
                        <Trigger Property="VerticalAlignment" Value="Stretch">
                            <Setter TargetName="PART_Content" Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
