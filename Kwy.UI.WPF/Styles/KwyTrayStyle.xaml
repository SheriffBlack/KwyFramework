<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kwy.UI.WPF.Behaviors"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Style x:Key="KwyTrayStyle" TargetType="{x:Type controls:KwyTray}">
        <!--  设置模板，包含 ItemsPresenter 和选择框装饰层  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyTray}">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ItemsPresenter />
                        </Border>
                        <!--  选择框装饰层  -->
                        <Canvas x:Name="PART_SelectionCanvas" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  设置 ItemsPanel  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=controls:KwyTray}}"
                        IsItemsHost="True"
                        Rows="{Binding Rows, RelativeSource={RelativeSource AncestorType=controls:KwyTray}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <!--  设置 ItemTemplate  -->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border
                        Width="40"
                        Height="40"
                        Margin="4"
                        CornerRadius="0">
                        <Border.ToolTip>
                            <TextBlock Text="{Binding Status, StringFormat='盘孔状态：{0}'}" />
                        </Border.ToolTip>

                        <!--  使用 ClickShowContextMenuBehavior 处理菜单弹出  -->
                        <i:Interaction.Behaviors>
                            <behavior:ClickShowContextMenuBehavior />
                        </i:Interaction.Behaviors>

                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="MousePoint">
                                <i:Interaction.Behaviors>
                                    <behavior:PlateItemMenuBehavior />
                                </i:Interaction.Behaviors>
                                <MenuItem Header="OK" />
                                <MenuItem Header="NG" />
                                <Separator />
                                <MenuItem Header="无料" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Border.Style>
                            <Style TargetType="Border">
                                <!--  默认无料  -->
                                <Style.Triggers>
                                    <!--  无料状态  -->
                                    <DataTrigger Binding="{Binding Status}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource NoMaterialBrush}" />
                                        <!--  无料灰  -->
                                    </DataTrigger>
                                    <!--  OK 状态  -->
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource OKBrush}" />
                                        <!--  OK 绿  -->
                                    </DataTrigger>
                                    <!--  NG 状态  -->
                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource NGBrush}" />
                                        <!--  NG 红  -->
                                    </DataTrigger>

                                    <!--  被选中  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimarySelectedBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource KwyTrayStyle}" TargetType="{x:Type controls:KwyTray}" />
</ResourceDictionary>
