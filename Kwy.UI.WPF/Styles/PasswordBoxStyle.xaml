<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/SegoeFluentStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/StoryboardStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="DefaultPasswordBoxStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="28.4" />
        <Setter Property="Height" Value="37.56" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  图标：支持字符串字体图标和 Geometry 路径图标  -->
                            <ContentPresenter
                                x:Name="PART_Icon"
                                Grid.Column="0"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding Path=(helpers:IconHelper.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <Trigger Property="Content" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                                <ContentPresenter.Resources>
                                    <!--  字符串类型：字体图标  -->
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding}" />
                                    </DataTemplate>
                                    <!--  Geometry 类型：路径图标  -->
                                    <DataTemplate DataType="{x:Type Geometry}">
                                        <Path Data="{Binding}" Style="{StaticResource IconPathStyle}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!--  PART_ContentHost 必须始终存在且可见，这是 PasswordBox 的必需部件  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Focusable="False" />

                            <!--  底部下划线：通过触发器控制状态  -->
                            <Border
                                x:Name="PART_BottomBorder"
                                Grid.ColumnSpan="2"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ControlBorderBrush}" />
                            <!--  默认下划线颜色  -->
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                            <!--  聚焦颜色  -->
                            <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                            <!--  聚焦时下划线加粗  -->
                            <!--  动画过渡：避免状态切换生硬  -->
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                            </Trigger.EnterActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultPasswordBoxStyle}" TargetType="PasswordBox" />

    <Style
        x:Key="IconPasswordBoxStyle"
        BasedOn="{StaticResource DefaultPasswordBoxStyle}"
        TargetType="PasswordBox">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Height" Value="45" />
    </Style>
</ResourceDictionary>
