<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="DefaultLabelStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="Label">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border
                        x:Name="PART_LabelBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0">
                        <Grid>
                            <ContentPresenter
                                x:Name="PART_ContentHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultLabelStyle}" TargetType="Label" />

    <Style
        x:Key="LabelContentVerticalStyle"
        BasedOn="{StaticResource DefaultLabelStyle}"
        TargetType="Label">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Margin="5" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType=Label}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock Style="{StaticResource BtnVerticalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="44" Height="44">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Label}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource BtnVerticalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Label}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="LabelContentHorizontalStyle"
        BasedOn="{StaticResource DefaultLabelStyle}"
        TargetType="Label">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType=Label}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock FontSize="28" Style="{StaticResource BtnHorizontalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="28" Height="28">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Label}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Rectangle Grid.Column="1" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="16"
                            Style="{StaticResource BtnHorizontalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Label}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
