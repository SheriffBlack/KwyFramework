<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.Controls"
    xmlns:system="clr-namespace:System;assembly=netstandard">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/SegoeFluentStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/IconStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/WindowButtonStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:KwyWindow}">
        <Setter Property="TitleBarBackground" Value="{DynamicResource WindowTitleBarBackgroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0.4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="AllowsTransparency" Value="False" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    CaptionHeight="0"
                    CornerRadius="0"
                    GlassFrameThickness="0"
                    ResizeBorderThickness="6"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyWindow}">
                    <Border
                        x:Name="PART_WindowBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                x:Name="PART_TitleBarBackground"
                                Grid.Row="0"
                                Height="{TemplateBinding TitleBarHeight}"
                                Background="{TemplateBinding TitleBarBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,0.7">
                                <Grid x:Name="PART_TitleBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Margin="16,0,12,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <ContentPresenter
                                            x:Name="PART_Icon"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,8,0"
                                            Content="{TemplateBinding Icon}">
                                            <ContentPresenter.Resources>
                                                <DataTemplate DataType="{x:Type system:String}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding TitleBarBackground, RelativeSource={RelativeSource AncestorType=controls:KwyWindow}}"
                                                        FontFamily="{StaticResource SegoeFluent}"
                                                        FontSize="20"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:KwyWindow}}"
                                                        Text="{Binding}" />
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type Geometry}">
                                                    <Viewbox Width="20" Height="20">
                                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:KwyWindow}}" />
                                                    </Viewbox>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type ImageSource}">
                                                    <Image Source="{Binding}" Stretch="Uniform" />
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                        <TextBlock
                                            x:Name="PART_TitleText"
                                            VerticalAlignment="Center"
                                            Background="{Binding TitleBarBackground, RelativeSource={RelativeSource AncestorType=controls:KwyWindow}}"
                                            FontSize="16"
                                            Foreground="{DynamicResource WindowTitleBarForegroundBrush}"
                                            Text="{TemplateBinding Title}" />
                                    </StackPanel>

                                    <DockPanel
                                        Grid.Column="1"
                                        Background="Transparent"
                                        LastChildFill="True">
                                        <!--  透明拖拽区域填充标题栏剩余空间  -->
                                        <Border Background="Transparent" />

                                        <ContentPresenter
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding TitleBarContent}"
                                            DockPanel.Dock="Right"
                                            RecognizesAccessKey="True" />
                                    </DockPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <Button
                                            x:Name="PART_UserButton"
                                            Command="{Binding UserCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="{Binding UserCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="{StaticResource IconContact}"
                                            FontSize="20"
                                            Style="{StaticResource KwyWindowButtonStyle}" />
                                        <Button
                                            x:Name="PART_MinimizeButton"
                                            Content="{StaticResource IconMin}"
                                            Style="{StaticResource KwyWindowButtonStyle}" />

                                        <Grid>
                                            <Button
                                                x:Name="PART_MaximizeButton"
                                                Content="{StaticResource IconMax}"
                                                Style="{StaticResource KwyWindowButtonStyle}" />
                                            <Button
                                                x:Name="PART_RestoreButton"
                                                Content="{StaticResource IconRestore}"
                                                Style="{StaticResource KwyWindowButtonStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>

                                        <Button
                                            x:Name="PART_CloseButton"
                                            Content="{StaticResource IconClose}"
                                            Style="{StaticResource KwyWindowButtonCloseStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  内容区  -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  未设置 Icon 时隐藏图标占位  -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  窗口未激活时降低透明度  -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_WindowBorder" Property="Opacity" Value="0.7" />
                        </Trigger>

                        <Trigger Property="controls:KwyWindow.IsMaximizedToWorkArea" Value="True">
                            <Setter TargetName="PART_WindowBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_WindowBorder" Property="Margin" Value="0" />
                            <Setter TargetName="PART_WindowBorder" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="controls:KwyWindow.IsMaximizedToWorkArea" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="controls:KwyWindow.ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="controls:KwyWindow.ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="controls:KwyWindow.ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="controls:KwyWindow.ShowUserButton" Value="False">
                            <Setter TargetName="PART_UserButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
