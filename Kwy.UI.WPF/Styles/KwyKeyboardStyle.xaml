                                            HorizontalAlignment="Center"
                                            Style="{StaticResource NumberTextBlockStyle}"
                                            Text="1" />
                                    </Grid>
                                </Button>
                                <Button
                                    Grid.Column="6"
                                    Grid.ColumnSpan="2"
