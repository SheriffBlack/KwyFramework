                                    Focusable="{TemplateBinding Focusable}"
                                    Style="{TemplateBinding KwyKeyboardButtonStyle}">
                                    <Grid Margin="10,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
