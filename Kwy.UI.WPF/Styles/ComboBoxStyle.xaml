<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:Kwy.UI.WPF.Converters"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/SegoeFluentStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/StoryboardStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/IconStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  转换器资源  -->
    <convert:ComboBoxIconConverter x:Key="ComboBoxIconConverter" />
    <convert:ComboBoxContentConverter x:Key="ComboBoxContentConverter" />

    <!--  通用 ComboBox 模板 (支持图标)  -->
    <ControlTemplate x:Key="SharedComboBoxTemplate" TargetType="ComboBox">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="0">
            <Grid MinHeight="{TemplateBinding MinHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  图标：支持字符串（字体图标）和 Geometry 类型  -->
                <ContentPresenter
                    x:Name="PART_Icon"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="10,0,10,0" />
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                    <ContentPresenter.Content>
                        <MultiBinding Converter="{StaticResource ComboBoxIconConverter}" UpdateSourceTrigger="PropertyChanged">
                            <Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                            <Binding Path="(helpers:IconHelper.Icon)" RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                        </MultiBinding>
                    </ContentPresenter.Content>
                    <ContentPresenter.Resources>
                        <!--  字符串类型：字体图标  -->
                        <DataTemplate DataType="{x:Type system:String}">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding}" />
                        </DataTemplate>
                        <!--  Geometry 类型：路径图标  -->
                        <DataTemplate DataType="{x:Type Geometry}">
                            <Path Data="{Binding}" Style="{StaticResource IconPathStyle}" />
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!--  可编辑模式：显示 TextBox  -->
                <TextBox
                    x:Name="PART_EditableTextBox"
                    Grid.Column="1"
                    Margin="0,0,5,2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}"
                    Foreground="{TemplateBinding Foreground}"
                    IsReadOnly="{TemplateBinding IsReadOnly}"
                    Style="{x:Null}"
                    Visibility="Collapsed" />

                <!--  不可编辑模式：显示选中项  -->
                <!--  直接绑定到 SelectedItem，避免 SelectionBoxItem 在 ContentPresenter 环境中的更新问题  -->
                <ContentPresenter
                    x:Name="PART_ContentSite"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    IsHitTestVisible="False">
                    <ContentPresenter.Content>
                        <MultiBinding Converter="{StaticResource ComboBoxContentConverter}" UpdateSourceTrigger="PropertyChanged">
                            <Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                        </MultiBinding>
                    </ContentPresenter.Content>
                </ContentPresenter>

                <ToggleButton
                    x:Name="PART_ToggleButton"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    helpers:RippleEffectHelper.IsEnabled="True"
                    helpers:RippleEffectHelper.RippleBrush="{DynamicResource RippleBrush}"
                    ClickMode="Press"
                    Focusable="False"
                    IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    Template="{StaticResource TransparentToggleButtonTemplate}" />

                <Path
                    x:Name="PART_Arrow"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource IconDownArrow}"
                    Fill="{TemplateBinding Foreground}"
                    IsHitTestVisible="False" />

                <Popup
                    x:Name="PART_Popup"
                    AllowsTransparency="True"
                    Focusable="False"
                    IsOpen="{TemplateBinding IsDropDownOpen}"
                    Placement="Bottom"
                    PopupAnimation="Slide">
                    <Grid
                        x:Name="PART_DropDown"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        SnapsToDevicePixels="True">
                        <Border
                            x:Name="PART_DropDownBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>

                <!--  底部下划线：核心元素，通过触发器控制状态  -->
                <Border
                    x:Name="PART_BottomBorder"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlBorderBrush}" />
                <!--  默认下划线颜色  -->
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="PART_DropDownBorder" Property="MinHeight" Value="95" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </MultiTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <!--  条件1：ComboBox 可编辑  -->
                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource Self}}" Value="True" />
                    <!--  条件2：内部 TextBox 获得键盘焦点（核心修正）  -->
                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=PART_EditableTextBox}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                <!--  启动动画（已绑定 TargetName）  -->
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>

            <!--  可编辑模式：显示 TextBox，隐藏 ContentPresenter，ToggleButton 只在右侧  -->
            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_ContentSite" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ToggleButton" Property="Grid.Column" Value="2" />
                <Setter TargetName="PART_ToggleButton" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>

            <!--  不可编辑模式：显示 ContentPresenter，隐藏 TextBox，ToggleButton 覆盖整个区域  -->
            <Trigger Property="IsEditable" Value="False">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ContentSite" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_ToggleButton" Property="Grid.Column" Value="0" />
                <Setter TargetName="PART_ToggleButton" Property="Grid.ColumnSpan" Value="3" />
            </Trigger>

            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_Arrow" Property="Data" Value="{StaticResource IconUpArrow}" />
                <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                <!--  聚焦蓝色  -->
                <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                <!--  聚焦时下划线变粗  -->
                <!--  动画过渡：避免状态切换生硬  -->
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                </Trigger.EnterActions>
            </Trigger>

            <!--  当选中项有图标时，使用选中项的图标  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                <Setter TargetName="PART_Arrow" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  提取 ComboBoxItem 模板  -->
    <ControlTemplate x:Key="DefaultComboBoxItemTemplate" TargetType="ComboBoxItem">
        <Border
            x:Name="PART_CbxItemBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="0">
            <Grid>
                <ContentPresenter
                    x:Name="PART_ContentHost"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                <Canvas
                    x:Name="PART_RippleCanvas"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_CbxItemBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="PART_CbxItemBorder" Property="Background" Value="{DynamicResource BackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IconComboBoxItemTemplate" TargetType="ComboBoxItem">
        <Border
            x:Name="PART_CbxItemBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                    IsHitTestVisible="False">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="10,5,10,5" />
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type system:String}">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type Geometry}">
                            <Path Data="{Binding}" Style="{StaticResource IconPathStyle}" />
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                <Canvas
                    x:Name="PART_RippleCanvas"
                    Grid.ColumnSpan="2"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_CbxItemBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="PART_CbxItemBorder" Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ControlSelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style
        x:Key="DefaultComboBoxStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28.4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource SharedComboBoxTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox" />

    <Style
        x:Key="IconComboBoxStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="ComboBox">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Template" Value="{StaticResource SharedComboBoxTemplate}" />
    </Style>

    <Style
        x:Key="DefaultComboBoxItemStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="28.4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="helpers:RippleEffectHelper.IsEnabled" Value="True" />
        <Setter Property="helpers:RippleEffectHelper.RippleBrush" Value="{DynamicResource RippleBrush}" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxItemTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultComboBoxItemStyle}" TargetType="ComboBoxItem" />

    <Style
        x:Key="IconComboBoxItemStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="ComboBoxItem">
        <Setter Property="helpers:RippleEffectHelper.IsEnabled" Value="True" />
        <Setter Property="helpers:RippleEffectHelper.RippleBrush" Value="{DynamicResource RippleBrush}" />
        <Setter Property="Template" Value="{StaticResource IconComboBoxItemTemplate}" />
    </Style>
</ResourceDictionary>

