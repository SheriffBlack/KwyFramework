<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kwy.UI.WPF.Controls"
    xmlns:percent="clr-namespace:Kwy.UI.WPF.Controls.Percent">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <percent:PercentValueTextConverter x:Key="PercentValueTextConverter" />
    <percent:PercentCountTextConverter x:Key="PercentCountTextConverter" />

    <Style BasedOn="{StaticResource ControlBaseStyle}" TargetType="{x:Type controls:KwyPercent}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BarBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="1" Color="{DynamicResource PrimaryGradualColor}" />
                    <GradientStop Offset="0.5" Color="{DynamicResource PrimaryGradualColor}" />
                    <GradientStop Offset="0" Color="{DynamicResource PrimaryColor}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KwyPercent}">
                    <Border
                        x:Name="PART_Root"
                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True"
                        ToolTipService.IsEnabled="{TemplateBinding ShowToolTip}">
                        <Border.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PercentValueTextConverter}">
                                                <Binding Path="PlacementTarget.Tag.Percentage" RelativeSource="{RelativeSource AncestorType=ToolTip}" />
                                                <Binding Path="PlacementTarget.Tag.PercentageStringFormat" RelativeSource="{RelativeSource AncestorType=ToolTip}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock x:Name="PART_ToolTipCount">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PercentCountTextConverter}">
                                                <Binding Path="PlacementTarget.Tag.Current" RelativeSource="{RelativeSource AncestorType=ToolTip}" />
                                                <Binding Path="PlacementTarget.Tag.Total" RelativeSource="{RelativeSource AncestorType=ToolTip}" />
                                                <Binding Path="PlacementTarget.Tag.CountStringFormat" RelativeSource="{RelativeSource AncestorType=ToolTip}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlacementTarget.Tag.ShowCount, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>

                        <Grid>
                            <Rectangle Fill="{DynamicResource ControlBackgroundBrush}" />
                            <Rectangle
                                VerticalAlignment="Stretch"
                                Fill="{TemplateBinding BarBrush}"
                                RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <StackPanel
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                                <TextBlock
                                    x:Name="PART_PercentageText"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ForegroundBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PercentValueTextConverter}">
                                            <Binding Path="Percentage" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="PercentageStringFormat" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock
                                    x:Name="PART_CountText"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    TextAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PercentCountTextConverter}">
                                            <Binding Path="Current" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Total" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="CountStringFormat" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPercentage" Value="False">
                            <Setter TargetName="PART_PercentageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCount" Value="False">
                            <Setter TargetName="PART_CountText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
