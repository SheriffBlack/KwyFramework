<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource ControlBaseStyle}" TargetType="GroupBox">
        <!--  设置默认值，使其更可控  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,0,5,0" />
        <Setter Property="Margin" Value="1,0,1,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="true">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--  底部内容区域边框（包含左、右、底部边框）  -->
                        <Border
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,0,1,1" />

                        <!--  Header部分和上边框  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <!--  左侧上边框和左侧连接  -->
                            <Border
                                x:Name="PART_LeftTopBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="10"
                                Margin="0,10,5,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,0" />

                            <!--  Header内容  -->
                            <ContentPresenter
                                x:Name="PART_Header"
                                Grid.Column="1"
                                Margin="0"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <!--  右侧上边框和右侧连接  -->
                            <Border
                                x:Name="PART_RightTopBorder"
                                Grid.Row="0"
                                Grid.Column="2"
                                Height="10"
                                Margin="5,10,0,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,1,0" />
                        </Grid>

                        <!--  内容区域  -->
                        <ContentPresenter
                            Grid.Row="1"
                            Margin="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>

                    <!--  当 Header 没有文字时，中间的 ContentPresenter 宽度变为 0，左边框（带有上边线）和右边框（带有上边线）失去了 Margin 的阻碍，会直接贴在一起  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_LeftTopBorder" Property="Margin" Value="0,10,0,0" />
                            <Setter TargetName="PART_RightTopBorder" Property="Margin" Value="0,10,0,0" />
                        </Trigger>

                        <Trigger Property="Header" Value="">
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_LeftTopBorder" Property="Margin" Value="0,10,0,0" />
                            <Setter TargetName="PART_RightTopBorder" Property="Margin" Value="0,10,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
