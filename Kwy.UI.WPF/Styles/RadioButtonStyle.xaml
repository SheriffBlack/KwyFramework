<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Kwy.UI.WPF.Converters"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:StringEqualityConverter x:Key="StringEqualityConverter" />

    <Style BasedOn="{StaticResource ControlBaseStyle}" TargetType="RadioButton">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">

                        <BulletDecorator VerticalAlignment="Center">
                            <!--  鍕鹃€夋  -->
                            <BulletDecorator.Bullet>
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <!--  澶栧渾  -->
                                    <Ellipse
                                        Width="28"
                                        Height="28"
                                        Stroke="{TemplateBinding Foreground}"
                                        StrokeThickness="2" />
                                    <!--  閫変腑鐘舵€佺殑鍐呭渾  -->
                                    <Ellipse
                                        x:Name="PART_CheckMark"
                                        Width="18"
                                        Height="18"
                                        Fill="{TemplateBinding Foreground}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </BulletDecorator.Bullet>
                            <!--  鏂囧瓧  -->
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" />
                            </Border>
                        </BulletDecorator>
                    </Border>

                    <!--  瑙﹀彂鍣ㄦ帶鍒堕€変腑鏃剁殑鍐呭渾鏄剧ず  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="NavigationButtonBaseStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="GroupName" Value="NavigationGroup" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="PART_Icon"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding Path=(helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock
                                            FontSize="35"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                            Style="{StaticResource BtnHorizontalStyleTextBlockIcon}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type Geometry}">
                                        <Viewbox Stretch="Uniform">
                                            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                                        </Viewbox>
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{TemplateBinding Content}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ControlFocusedBorderBrush}" />
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  一级导航按钮样式  -->
    <Style
        x:Key="NavigationButtonStyle"
        BasedOn="{StaticResource NavigationButtonBaseStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="Content" Value="{Binding DisplayText}" />
        <Setter Property="helpers:IconHelper.Icon" Value="{Binding Icon, Converter={converters:IconKeyToResourceConverter}}" />
        <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="IsChecked">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource StringEqualityConverter}" Mode="OneWay">
                    <Binding
                        Mode="OneWay"
                        Path="DataContext.SelectedNavigationKey"
                        RelativeSource="{RelativeSource AncestorType=UserControl}"
                        UpdateSourceTrigger="PropertyChanged" />
                    <Binding Mode="OneWay" Path="NavigationKey" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>


    <Style
        x:Key="RadioButtonItemStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="35" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="PART_RadioButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid
                            x:Name="PART_CheckMark"
                            Margin="20,0,20,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ControlTextBlockStyle}" Text="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_RadioButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_RadioButtonBorder" Property="BorderThickness" Value="0,2,0,0" />
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="0.5" />
                            <!--<Setter Property="Opacity" Value="0.1" />-->
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter Property="Opacity" Value="0.5" />-->
                            <Setter TargetName="PART_RadioButtonBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Direction="315"
                                        Opacity="0.7"
                                        ShadowDepth="5"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <!--<Setter Property="Opacity" Value="1" />-->
                            <Setter TargetName="PART_RadioButtonBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Direction="315"
                                        Opacity="0.5"
                                        ShadowDepth="2"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="BaseRadioButtonStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="PART_RadioButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_CheckMark">
                            <ContentPresenter
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Margin}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Background" Value="{DynamicResource PrimarySelectedBrush}" />
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Direction="315"
                                        Opacity="0.7"
                                        ShadowDepth="5"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Direction="315"
                                        Opacity="0.5"
                                        ShadowDepth="2"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Opacity" Value="0.1" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RadioButtonContentVerticalStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="80" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock Style="{StaticResource BtnVerticalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="44" Height="44">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource BtnVerticalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RadioButtonContentHorizontalStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="60" />
        <Setter Property="Width" Value="120" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock FontSize="34" Style="{StaticResource BtnHorizontalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="34" Height="34">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Rectangle Grid.Column="1" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="16"
                            Style="{StaticResource BtnHorizontalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
