<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Kwy.UI.WPF.Converters"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:StringEqualityConverter x:Key="StringEqualityConverter" />

    <Style
        x:Key="DefaultRadioButtonStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="RadioButton">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">

                        <BulletDecorator VerticalAlignment="Center">
                            <!--  勾选框  -->
                            <BulletDecorator.Bullet>
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <!--  外圆  -->
                                    <Ellipse
                                        Width="28"
                                        Height="28"
                                        Stroke="{TemplateBinding Foreground}"
                                        StrokeThickness="2" />
                                    <!--  选中状态的内圆  -->
                                    <Ellipse
                                        x:Name="PART_CheckMark"
                                        Width="18"
                                        Height="18"
                                        Fill="{TemplateBinding Foreground}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </BulletDecorator.Bullet>
                            <!--  文字  -->
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" />
                            </Border>
                        </BulletDecorator>
                    </Border>

                    <!--  触发器控制选中时的内圆显示  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RadioButtonItemStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="35" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="PART_RadioButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid
                            x:Name="PART_CheckMark"
                            Margin="20,0,20,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ControlTextBlockStyle}" Text="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ControlSelectedForegroundBrush}" />
                            <Setter TargetName="PART_RadioButtonBorder" Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                            <Setter TargetName="PART_RadioButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_RadioButtonBorder" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                            <!--<Setter Property="Opacity" Value="0.1" />-->
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="BaseRadioButtonStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="PART_RadioButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_CheckMark">
                            <ContentPresenter
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Margin}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlSelectedForegroundBrush}" />
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_CheckMark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RadioButtonBorder" Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RadioButtonContentVerticalStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="80" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock Style="{StaticResource BtnVerticalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="44" Height="44">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource BtnVerticalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RadioButtonContentHorizontalStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="60" />
        <Setter Property="Width" Value="120" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type system:String}">
                                    <TextBlock FontSize="34" Style="{StaticResource BtnHorizontalStyleTextBlockIcon}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <Viewbox Width="34" Height="34">
                                        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Rectangle Grid.Column="1" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="16"
                            Style="{StaticResource BtnHorizontalStyleTextBlock}"
                            Text="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>


