<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/TextBlockStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  TabControl 样式：确保内容区域占满  -->
    <Style TargetType="TabControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" />
                        <ContentPresenter
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem 样式：参考 RadioButtonItemStyle  -->
    <Style BasedOn="{StaticResource ControlBaseStyle}" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="35" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="PART_TabItemBorder" BorderThickness="0,1,0,0">
                        <Grid>
                            <!--  右侧分隔线（垂直分隔线）  -->
                            <Border
                                x:Name="PART_RightBorder"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BorderBrush}"
                                Opacity="0.3" />
                            <!--  TabItem 内容区域  -->
                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                <Grid
                                    x:Name="PART_ContentGrid"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="PART_HeaderTextBlock"
                                        Margin="20,0,20,0"
                                        Style="{StaticResource ControlTextBlockStyle}"
                                        Text="{TemplateBinding Header}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  选中状态  -->
                        <Trigger Property="IsSelected" Value="True">
                            <!--  只设置 Header TextBlock 的颜色，不影响内容区域  -->
                            <Setter TargetName="PART_HeaderTextBlock" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_TabItemBorder" Property="BorderThickness" Value="0,2,0,0" />
                            <Setter TargetName="PART_TabItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="PART_ContentGrid" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <!--  未选中状态  -->
                        <Trigger Property="IsSelected" Value="False">
                            <!--  恢复 Header TextBlock 的默认颜色  -->
                            <Setter TargetName="PART_ContentGrid" Property="Opacity" Value="1" />
                        </Trigger>

                        <!--  鼠标悬停效果：SourceName 锁定到 header Border，避免悬停 content 区域误触发  -->
                        <Trigger SourceName="PART_TabItemBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_TabItemBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Direction="315"
                                        Opacity="0.7"
                                        ShadowDepth="5"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger SourceName="PART_TabItemBorder" Property="IsMouseOver" Value="False">
                            <Setter TargetName="PART_TabItemBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Direction="315"
                                        Opacity="0.5"
                                        ShadowDepth="2"
                                        Color="{DynamicResource DropShadowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
