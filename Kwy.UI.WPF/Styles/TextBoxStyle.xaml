<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/SegoeFluentStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/StoryboardStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  鍩虹鏍峰紡锛氬寘鍚叕鍏卞睘鎬у拰瑙﹀彂鍣?  -->
    <Style
        x:Key="BaseTextBoxStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="TextBox" />

    <!--  鍩虹 TextBox 妯℃澘锛氭彁鍙栧叕鍏辩殑 ControlTemplate 缁撴瀯  -->
    <ControlTemplate x:Key="BaseTextBoxTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  杈撳叆鍖哄煙锛氫繚鐣欏師鐢?ScrollViewer锛屾敮鎸佹崲琛屽拰婊氬姩  -->
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Grid.Column="0"
                    Margin="0,0,0,3"
                    Padding="{TemplateBinding Padding}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />

                <Button
                    x:Name="PART_AdornerButton"
                    Grid.Column="1"
                    Margin="5,0,0,3"
                    Padding="10,0"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Command="{Binding Path=(helpers:InputAdornerHelper.ButtonCommand), RelativeSource={RelativeSource TemplatedParent}}"
                    CommandParameter="{Binding Path=(helpers:InputAdornerHelper.ButtonCommandParameter), RelativeSource={RelativeSource TemplatedParent}}"
                    Content="{Binding Path=(helpers:InputAdornerHelper.ButtonContent), RelativeSource={RelativeSource TemplatedParent}}" />

                <TextBlock
                    x:Name="PART_AdornerUnit"
                    Grid.Column="2"
                    Margin="5,0,5,3"
                    VerticalAlignment="Center"
                    Text="{Binding Path=(helpers:InputAdornerHelper.Unit), RelativeSource={RelativeSource TemplatedParent}}" />

                <!--  搴曢儴涓嬪垝绾匡細閫氳繃瑙﹀彂鍣ㄦ帶鍒剁姸鎬?  -->
                <Border
                    x:Name="PART_BottomBorder"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlBorderBrush}" />
            </Grid>
        </Border>

        <!--  鐘舵€佽Е鍙戝櫒锛氶粯璁ゃ€佽仛鐒︺€佺鐢ㄣ€佸彧璇?  -->
        <ControlTemplate.Triggers>
            <!--  鑱氱劍鐘舵€侊細涓嬪垝绾垮彉涓虹劍鐐硅壊锛屽苟甯︽贰鍏ュ姩鐢?  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                </Trigger.EnterActions>
            </Trigger>

            <!--  绂佺敤鐘舵€侊細鏂囨湰鍙樼伆  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
            </Trigger>

            <!--  鍙鐘舵€侊細鑳屾櫙浣跨敤鍙璧勬簮  -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlReadOnlyForegroundBrush}" />
            </Trigger>

            <!--  鍗曚綅鏂囨湰鍙鎬?  -->
            <Trigger Property="helpers:InputAdornerHelper.Unit" Value="">
                <Setter TargetName="PART_AdornerUnit" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="helpers:InputAdornerHelper.Unit" Value="{x:Null}">
                <Setter TargetName="PART_AdornerUnit" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  闄勫姞鎸夐挳鍙鎬?  -->
            <Trigger Property="helpers:InputAdornerHelper.ButtonCommand" Value="{x:Null}">
                <Setter TargetName="PART_AdornerButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  鍗曡 TextBox 鏍峰紡  -->
    <Style
        x:Key="DefaultTextBoxStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template" Value="{StaticResource BaseTextBoxTemplate}" />
        <Setter Property="MinHeight" Value="28.4" />
    </Style>

    <!--  澶氳 TextBox 鏍峰紡  -->
    <Style
        x:Key="DefaultTextBoxMultiStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template" Value="{StaticResource BaseTextBoxTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox" />


    <!--  甯﹀浘鏍囩殑 TextBox 鏍峰紡锛氫繚鐣欑嫭绔嬫ā鏉匡紝鍥犱负缁撴瀯涓嶅悓  -->
    <Style
        x:Key="IconTextBoxStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  鍥炬爣锛氭敮鎸佸瓧绗︿覆瀛椾綋鍥炬爣鍜?Geometry 绫诲瀷  -->
                            <ContentPresenter
                                x:Name="PART_Icon"
                                Grid.Column="0"
                                Margin="10,0,10,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock
                                            FontFamily="{StaticResource SegoeFluent}"
                                            FontSize="30"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type Geometry}">
                                        <Path
                                            Width="20"
                                            Height="20"
                                            Data="{Binding}"
                                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Stretch="Uniform" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!--  杈撳叆鍐呭  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Focusable="False" />
                            <TextBlock
                                x:Name="PART_Watermark"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="&#x7528;&#x6237;&#x540D;/&#x8D26;&#x53F7;/&#x624B;&#x673A;&#x53F7;"
                                Visibility="Collapsed" />

                            <!--  搴曢儴涓嬪垝绾匡細閫氳繃瑙﹀彂鍣ㄦ帶鍒剁姸鎬?  -->
                            <Border
                                x:Name="PART_BottomBorder"
                                Grid.ColumnSpan="2"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ControlBorderBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  姘村嵃鏄剧ず锛氱┖鏂囨湰涓旀湭鑱氱劍鏃舵樉绀?  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                        </MultiTrigger>

                        <!--  鑱氱劍鐘舵€侊細涓嬪垝绾垮彉涓虹劍鐐硅壊锛屽苟甯︽贰鍏ュ姩鐢?  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                            <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                            </Trigger.EnterActions>
                        </Trigger>

                        <!--  绂佺敤鐘舵€侊細鏂囨湰鍙樼伆  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>

                        <!--  鍙鐘舵€侊細鏂囨湰浣跨敤鍙璧勬簮  -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ControlReadOnlyForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>



