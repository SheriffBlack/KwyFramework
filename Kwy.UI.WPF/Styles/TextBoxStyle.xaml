<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers"
    xmlns:system="clr-namespace:System;assembly=netstandard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/SegoeFluentStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Kwy.UI.WPF;component/Styles/StoryboardStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  基础样式：包含公共属性和触发器  -->
    <Style
        x:Key="BaseTextBoxStyle"
        BasedOn="{StaticResource ControlBaseStyle}"
        TargetType="TextBox" />

    <!--  基础 TextBox 模板：提取公共的 ControlTemplate 结构  -->
    <ControlTemplate x:Key="BaseTextBoxTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  输入区域：保留原生 ScrollViewer，支持换行和滚动  -->
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Grid.Column="0"
                    Margin="0,0,0,3"
                    Padding="{TemplateBinding Padding}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />

                <Button
                    x:Name="PART_AdornerButton"
                    Grid.Column="1"
                    Margin="5,0,0,3"
                    Padding="10,0"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Command="{Binding (helpers:InputAdornerHelper.ButtonCommand), RelativeSource={RelativeSource TemplatedParent}}"
                    CommandParameter="{Binding (helpers:InputAdornerHelper.ButtonCommandParameter), RelativeSource={RelativeSource TemplatedParent}}"
                    Content="{Binding (helpers:InputAdornerHelper.ButtonContent), RelativeSource={RelativeSource TemplatedParent}}" />

                <TextBlock
                    x:Name="PART_AdornerUnit"
                    Grid.Column="2"
                    Margin="5,0,5,3"
                    VerticalAlignment="Center"
                    Text="{Binding (helpers:InputAdornerHelper.Unit), RelativeSource={RelativeSource TemplatedParent}}" />

                <!--  底部下划线：通过触发器控制状态  -->
                <Border
                    x:Name="PART_BottomBorder"
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlBorderBrush}" />
            </Grid>
        </Border>

        <!--  状态触发器：默认、聚焦、禁用、只读  -->
        <ControlTemplate.Triggers>
            <!--  聚焦状态：下划线变为焦点色，并带淡入动画  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                </Trigger.EnterActions>
            </Trigger>

            <!--  禁用状态：文本变灰  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
            </Trigger>

            <!--  只读状态：背景使用只读资源  -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlReadOnlyForegroundBrush}" />
            </Trigger>

            <!--  单位文本可见性  -->
            <Trigger Property="helpers:InputAdornerHelper.Unit" Value="">
                <Setter TargetName="PART_AdornerUnit" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="helpers:InputAdornerHelper.Unit" Value="{x:Null}">
                <Setter TargetName="PART_AdornerUnit" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  附加按钮可见性  -->
            <Trigger Property="helpers:InputAdornerHelper.ButtonCommand" Value="{x:Null}">
                <Setter TargetName="PART_AdornerButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  单行 TextBox 样式  -->
    <Style
        x:Key="DefaultTextBoxStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template" Value="{StaticResource BaseTextBoxTemplate}" />
        <Setter Property="MinHeight" Value="28.4" />
    </Style>

    <!--  多行 TextBox 样式  -->
    <Style
        x:Key="DefaultTextBoxMultiStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template" Value="{StaticResource BaseTextBoxTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox" />


    <!--  带图标的 TextBox 样式：保留独立模板，因为结构不同  -->
    <Style
        x:Key="IconTextBoxStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  图标：支持字符串字体图标和 Geometry 类型  -->
                            <ContentPresenter
                                x:Name="PART_Icon"
                                Grid.Column="0"
                                Margin="10,0,10,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding (helpers:IconHelper.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock
                                            FontFamily="{StaticResource SegoeFluent}"
                                            FontSize="30"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type Geometry}">
                                        <Path
                                            Width="20"
                                            Height="20"
                                            Data="{Binding}"
                                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Stretch="Uniform" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!--  输入内容  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Focusable="False" />
                            <TextBlock
                                x:Name="PART_Watermark"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="用户名/账号/手机号"
                                Visibility="Collapsed" />

                            <!--  底部下划线：通过触发器控制状态  -->
                            <Border
                                x:Name="PART_BottomBorder"
                                Grid.ColumnSpan="2"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ControlBorderBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  水印显示：空文本且未聚焦时显示  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                        </MultiTrigger>

                        <!--  聚焦状态：下划线变为焦点色，并带淡入动画  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomBorder" Property="Background" Value="{DynamicResource ControlFocusedBorderBrush}" />
                            <Setter TargetName="PART_BottomBorder" Property="Height" Value="2" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusAnimationStoryboard}" />
                            </Trigger.EnterActions>
                        </Trigger>

                        <!--  禁用状态：文本变灰  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
                        </Trigger>

                        <!--  只读状态：文本使用只读资源  -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ControlReadOnlyForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
