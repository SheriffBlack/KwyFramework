<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  基础主题颜色 - 不直接用于UI元素，而是作为其他颜色的基础  -->
    <Color x:Key="PrimaryColor">#1976D2</Color>
    <Color x:Key="SecondaryColor">#FFC107</Color>
    <Color x:Key="AccentColor">#FF5722</Color>

    <Color x:Key="PrimaryGradualColor">#C0DCF3</Color>

    <Color x:Key="TransparentColor">Transparent</Color>
    <Color x:Key="BlackColor">#000000</Color>
    <Color x:Key="WhilteColor">#FFFFFF</Color>

    <!--  选中颜色(背景:PrimaryColor)  -->
    <Color x:Key="PrimarySelectedColor">#1E56A0</Color>

    <!--  阴影颜色  -->
    <Color x:Key="DropShadowColor">#000000</Color>

    <!--  水波纹效果颜色  -->
    <Color x:Key="RippleColor">#1E56A0</Color>
    <Color x:Key="InputOverlayHoverColor">#20000000</Color>
    <Color x:Key="SwitchUncheckedColor">#3A3A3A</Color>
    <Color x:Key="SwitchCheckedColor">#00BFFF</Color>

    <!--  OK、NG、无料颜色  -->
    <Color x:Key="OKColor">#D7F4E3</Color>
    <Color x:Key="NGColor">#FAD6D6</Color>
    <Color x:Key="NoMaterialColor">#D3D3D3</Color>

    <Color x:Key="EditColor">#1976D2</Color>
    <Color x:Key="DeleteColor">#DC3545</Color>

    <!--  连接、未连接  -->
    <Color x:Key="ConnectColor">#2E7D55</Color>
    <Color x:Key="DisconnectColor">#C2413B</Color>

    <!--  黑底字体颜色  -->
    <Color x:Key="ForegroundBlackBaseColor">#E2E8F0</Color>

    <!--  Kwy特定品牌颜色  -->
    <Color x:Key="KwyBlueColor">#00DDFF</Color>
    <Color x:Key="KwyPurpleColor">#7C4DFF</Color>
    <Color x:Key="KwyGreenColor">#008000</Color>
    <Color x:Key="KwyRedColor">#F44336</Color>
    <Color x:Key="KwyGrayColor">#808080</Color>

    <!--  高亮或状态提示色  -->
    <Color x:Key="DisabledTextColor">#A0A0A0</Color>
    <Color x:Key="SuccessColor">#2E7D55</Color>
    <Color x:Key="WarningColor">#B7791F</Color>
    <Color x:Key="ErrorColor">#C2413B</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="StatusSuccessBackgroundColor">#D7F4E3</Color>
    <Color x:Key="StatusWarningBackgroundColor">#FFF1C2</Color>
    <Color x:Key="StatusErrorBackgroundColor">#FAD6D6</Color>
    <Color x:Key="StatusInfoBackgroundColor">#DCEBFF</Color>
    <Color x:Key="HighlightColor">#FFEB3B</Color>
    <Color x:Key="FallbackBrushColor">#D3D3D3</Color>
    <Color x:Key="DropTargetBackgroundColor">#ADD8E6</Color>
    <Color x:Key="DropTargetBorderColor">#0000FF</Color>
    <Color x:Key="SelectionBorderColor">#1E90FF</Color>
    <Color x:Key="SelectionBackgroundColor">#1E1E90FF</Color>
    <Color x:Key="ControlSelectedBackgroundColor">#DCEBFF</Color>
    <Color x:Key="ControlSelectedForegroundColor">#0F2742</Color>

    <!--  导航区域背景色  -->
    <Color x:Key="MainNavigationBackgroundColor">#EEF4FA</Color>

    <!--  基础颜色画笔  -->
    <SolidColorBrush x:Key="TransparentBrush" Color="{DynamicResource TransparentColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryGradualBrush" Color="{DynamicResource PrimaryGradualColor}" />

    <SolidColorBrush x:Key="BlackBrush" Color="{DynamicResource BlackColor}" />
    <SolidColorBrush x:Key="WhilteBrush" Color="{DynamicResource WhilteColor}" />
    <SolidColorBrush x:Key="PrimarySelectedBrush" Color="{DynamicResource PrimarySelectedColor}" />
    <SolidColorBrush x:Key="DropShadowBrush" Color="{DynamicResource DropShadowColor}" />
    <SolidColorBrush x:Key="RippleBrush" Color="{DynamicResource RippleColor}" />
    <SolidColorBrush x:Key="InputOverlayHoverBrush" Color="{DynamicResource InputOverlayHoverColor}" />

    <SolidColorBrush x:Key="OKBrush" Color="{DynamicResource OKColor}" />
    <SolidColorBrush x:Key="NGBrush" Color="{DynamicResource NGColor}" />
    <SolidColorBrush x:Key="NoMaterialBrush" Color="{DynamicResource NoMaterialColor}" />

    <SolidColorBrush x:Key="EditBrush" Color="{DynamicResource EditColor}" />
    <SolidColorBrush x:Key="DeleteBrush" Color="{DynamicResource DeleteColor}" />

    <SolidColorBrush x:Key="ConnectBrush" Color="{DynamicResource ConnectColor}" />
    <SolidColorBrush x:Key="DisconnectBrush" Color="{DynamicResource DisconnectColor}" />

    <SolidColorBrush x:Key="ForegroundBlackBaseBrush" Color="{DynamicResource ForegroundBlackBaseColor}" />

    <!--  Kwy品牌颜色画笔  -->
    <SolidColorBrush x:Key="KwyBlueBrush" Color="{DynamicResource KwyBlueColor}" />
    <SolidColorBrush x:Key="KwyPurpleBrush" Color="{DynamicResource KwyPurpleColor}" />
    <SolidColorBrush x:Key="KwyGreenBrush" Color="{DynamicResource KwyGreenColor}" />
    <SolidColorBrush x:Key="KwyRedBrush" Color="{DynamicResource KwyRedColor}" />
    <SolidColorBrush x:Key="KwyGrayBrush" Color="{DynamicResource KwyGrayColor}" />

    <!--  状态颜色画笔  -->
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{DynamicResource DisabledTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="{DynamicResource StatusSuccessBackgroundColor}" />
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="{DynamicResource StatusWarningBackgroundColor}" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="{DynamicResource StatusErrorBackgroundColor}" />
    <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="{DynamicResource StatusInfoBackgroundColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource HighlightColor}" />
    <SolidColorBrush x:Key="FallbackBrush" Color="{DynamicResource FallbackBrushColor}" />
    <SolidColorBrush x:Key="DropTargetBackgroundBrush" Color="{DynamicResource DropTargetBackgroundColor}" />
    <SolidColorBrush x:Key="DropTargetBorderBrush" Color="{DynamicResource DropTargetBorderColor}" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{DynamicResource SelectionBorderColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{DynamicResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="{DynamicResource ControlSelectedBackgroundColor}" />
    <SolidColorBrush x:Key="ControlSelectedForegroundBrush" Color="{DynamicResource ControlSelectedForegroundColor}" />
    <SolidColorBrush x:Key="MainNavigationBackgroundBrush" Color="{DynamicResource MainNavigationBackgroundColor}" />

    <!--  窗口特定颜色  -->
    <Color x:Key="WindowBackgroundColor">#F0F0F0</Color>
    <Color x:Key="WindowBorderColor">#1976D2</Color>
    <Color x:Key="WindowCloseHoverColor">#E81123</Color>
    <Color x:Key="WindowClosePressedColor">#F1707A</Color>
    <Color x:Key="WindowButtonHoverColor">#DBDBDC</Color>
    <Color x:Key="WindowButtonPressedColor">#C1C1C2</Color>
    <Color x:Key="WindowButtonDisabledForegroundColor">#60FFFFFF</Color>
    <Color x:Key="WindowTitleBarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="WindowInactiveTitleBarColor">#E8E8E8</Color>
    <Color x:Key="WindowStatusBarColor">#E8E8E8</Color>
    <Color x:Key="DialogTitleBarColor">#1976D2</Color>
    <Color x:Key="WindowTitleBarForegroundColor">#000000</Color>
    <Color x:Key="WindowSecondaryForegroundColor">#333333</Color>

    <!--  窗口颜色画笔  -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{DynamicResource WindowBorderColor}" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="{DynamicResource WindowCloseHoverColor}" />
    <SolidColorBrush x:Key="WindowClosePressedBrush" Color="{DynamicResource WindowClosePressedColor}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="{DynamicResource WindowButtonHoverColor}" />
    <SolidColorBrush x:Key="WindowButtonPressedBrush" Color="{DynamicResource WindowButtonPressedColor}" />
    <SolidColorBrush x:Key="WindowButtonDisabledForegroundBrush" Color="{DynamicResource WindowButtonDisabledForegroundColor}" />
    <SolidColorBrush x:Key="WindowTitleBarBackgroundBrush" Color="{DynamicResource WindowTitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="WindowInactiveTitleBarBrush" Color="{DynamicResource WindowInactiveTitleBarColor}" />
    <SolidColorBrush x:Key="WindowStatusBarBrush" Color="{DynamicResource WindowStatusBarColor}" />
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="{DynamicResource DialogTitleBarColor}" />
    <SolidColorBrush x:Key="WindowTitleBarForegroundBrush" Color="{DynamicResource WindowTitleBarForegroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryForegroundBrush" Color="{DynamicResource WindowSecondaryForegroundColor}" />

    <!--
        命名约定说明：
        - WindowXXX: 窗口特定颜色
        - ControlXXX: 控件特定颜色
        - SystemXXX: 系统级别颜色
    -->
</ResourceDictionary>


