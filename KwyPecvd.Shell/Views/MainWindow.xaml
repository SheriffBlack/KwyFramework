<kwyui:KwyWindow
    x:Class="KwyPecvd.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:KwyPecvd.Contracts.Navigation;assembly=KwyPecvd.Contracts"
    Title="Pecvd"
    Width="800"
    Height="450"
    kwymvvm:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <kwyui:KwyWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="TextBlock">
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                </Style>
            </StackPanel.Resources>

            <Viewbox
                Width="18"
                Height="18"
                VerticalAlignment="Center">
                <Path Data="{StaticResource IconLanguage}" Fill="{DynamicResource ForegroundBrush}" />
            </Viewbox>

        </StackPanel>
    </kwyui:KwyWindow.TitleBarContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl kwymvvm:RegionManager.RegionName="{x:Static navigation:RegionNames.WindowRegion}" />

        <StatusBar
            Grid.Row="1"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <StatusBar.Resources>
                <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                </Style>
            </StatusBar.Resources>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                    <!--  关闭 LastChildFill，避免自动填充  -->
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
        </StatusBar>
    </Grid>
</kwyui:KwyWindow>
