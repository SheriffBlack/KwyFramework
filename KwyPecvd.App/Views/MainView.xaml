<UserControl
    x:Class="KwyPecvd.App.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:KwyPecvd.Contracts.App.Navigation;assembly=KwyPecvd.Contracts.App"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <kwyui:EqualityConverter x:Key="EqualityConverter" />
        <SolidColorBrush x:Key="HsyLogoBackgroundBrush" Color="#E60012" />

        <Style
            x:Key="MainNavigationButtonStyle"
            BasedOn="{StaticResource RadioButtonContentHorizontalStyle}"
            TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="Content" Value="{Binding DisplayText}" />
            <Setter Property="kwyui:IconHelper.Icon" Value="{Binding Path=Icon, Converter={kwyui:IconKeyToResourceConverter}}" />
            <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="GroupName" Value="MainNavigationGroup" />
            <Setter Property="IsEnabled" Value="{Binding IsNavigationEnabled}" />
            <Setter Property="IsChecked">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                        <Binding Path="DataContext.SelectedNavigationKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Path="NavigationKey" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  固定内容  -->
        <Border Grid.Row="0" Height="64" />

        <ContentControl Grid.Row="1" kwymvvm:RegionManager.RegionName="{x:Static navigation:RegionNames.MainRegion}" />

        <!--  底层导航  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource NavigationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,0,0.7">
            <Grid Height="64" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" />
                <Image Grid.Column="1" />
            </Grid>
        </Border>


    </Grid>
</UserControl>
