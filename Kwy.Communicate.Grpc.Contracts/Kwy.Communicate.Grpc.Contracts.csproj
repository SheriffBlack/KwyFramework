<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\eng\Kwy.Communicate.Version.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Kwy.Communicate.Grpc.Contracts</PackageId>
    <Description>Versioned gRPC contracts for the Kwy communication ecosystem.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.64.0" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\**\*.proto" GrpcServices="Both" />
    <None Update="Protos\**\*.proto" Pack="true" PackagePath="proto" />
  </ItemGroup>

</Project>
