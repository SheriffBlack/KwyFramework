<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <Target Name="PackChangedKwyNuGets" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(RunKwyPackaging)' != 'false'">
    <Message Importance="high" Text="Packing changed Kwy NuGet packages..." />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Pack-KwyNuGet.ps1&quot; -ChangedOnly -Configuration &quot;$(Configuration)&quot;" />
  </Target>
</Project>
