<kwyui:KwyWindow
    x:Class="KwyTemplate.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers;assembly=Kwy.UI.WPF"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:KwyTemplate.Contracts.Navigation;assembly=KwyTemplate.Contracts"
    Title="{Binding AppTitle}"
    kwymvvm:ViewModelLocator.AutoWireViewModel="True"
    Icon="{StaticResource ImgLogoHsy}"
    ShowUserButton="True"
    UserCommand="{Binding SwitchUserCommand}"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <kwyui:KwyWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="TextBlock">
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                </Style>
            </StackPanel.Resources>
            <TextBlock Text="机台号：119" Visibility="Collapsed" />
            <Rectangle Style="{StaticResource DefaultSeparatorStyle}" Visibility="Collapsed" />
            <TextBlock FontFamily="{StaticResource SegoeFluent}" Text="{StaticResource IconLanguage}" />
            <ComboBox
                Width="Auto"
                VerticalAlignment="Center"
                kwyui:IconHelper.Icon="{Binding SelectedLanguage.Icon, Converter={kwyui:IconKeyToResourceConverter}}"
                Background="{StaticResource TransparentBrush}"
                FontSize="18"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                Style="{StaticResource IconComboBoxStyle}"
                TextSearch.TextPath="Language">
                <ComboBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource IconComboBoxItemStyle}" TargetType="ComboBoxItem">
                        <Setter Property="kwyui:IconHelper.Icon" Value="{Binding Icon, Converter={kwyui:IconKeyToResourceConverter}}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Language}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Viewbox
                Width="20"
                Height="20"
                Margin="15,0,5,0">
                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource ForegroundBrush}" />
            </Viewbox>
            <TextBlock Text="{Binding CurrentTime}" />
            <Rectangle Style="{StaticResource DefaultSeparatorStyle}" />

        </StackPanel>
    </kwyui:KwyWindow.TitleBarContent>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl kwymvvm:RegionManager.RegionName="{x:Static navigation:RegionNames.WindowRegion}" />

        <StatusBar
            Grid.Row="1"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <StatusBar.Resources>
                <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                </Style>
            </StatusBar.Resources>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                    <!--  关闭 LastChildFill，避免自动填充  -->
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!--  PLC 连接状态  -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="5,0,5,0">
                        <Path Data="{StaticResource IconPLC}" Fill="{DynamicResource ForegroundBrush}" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Text.PlcConnectionStatus}" />
                    <Ellipse Margin="5,0,0,0" ToolTip="{Binding MainPlcConnectionState}">
                        <Ellipse.Style>
                            <Style BasedOn="{StaticResource DefaultEllipseStyle}" TargetType="Ellipse">
                                <!--  默认断开状态：浅红色  -->
                                <Setter Property="Fill" Value="{StaticResource DisconnectBrush}" />
                                <Style.Triggers>
                                    <!--  连接成功状态：亮绿色  -->
                                    <DataTrigger Binding="{Binding IsMainPlcConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ConnectBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
            </StatusBarItem>
            <Separator />

            <!--  CPU 占用  -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="5,0,5,0">
                        <Path Data="{StaticResource IconCPU}" Fill="{DynamicResource ForegroundBrush}" />
                    </Viewbox>
                    <TextBlock Background="{StaticResource TransparentBrush}" Text="{DynamicResource Text.CpuUsage}" />
                    <TextBlock
                        Width="35"
                        VerticalAlignment="Center"
                        Background="{StaticResource TransparentBrush}"
                        Text="{Binding OccupyCPU, StringFormat='{}{0:0.00}'}"
                        TextAlignment="Right"
                        Typography.NumeralAlignment="Tabular" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="%" />
                </StackPanel>
            </StatusBarItem>
            <Separator />

            <!--  运行内存  -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="5,0,5,0">
                        <Path Data="{StaticResource IconRAM}" Fill="{DynamicResource ForegroundBrush}" />
                    </Viewbox>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{DynamicResource Text.MemoryUsage}" />
                    <TextBlock
                        Width="45"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{Binding OccupyMemory, StringFormat='{}{0:0.00}'}"
                        TextAlignment="Right"
                        Typography.NumeralAlignment="Tabular" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text=" MB" />
                </StackPanel>
            </StatusBarItem>
            <Separator />

            <StatusBarItem DockPanel.Dock="Right">
                <Viewbox Width="15" Height="15">
                    <Path Data="{StaticResource IconDrag}" Fill="{DynamicResource ForegroundBrush}" />
                </Viewbox>
            </StatusBarItem>

            <!--  版权信息  -->
            <StatusBarItem DockPanel.Dock="Right" Visibility="Collapsed">
                <TextBlock Text="{Binding CopyrightText}" />
            </StatusBarItem>

            <!--  当前登录用户  -->
            <StatusBarItem Margin="0,0,50,0" DockPanel.Dock="Right">
                <Border
                    Padding="10,2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0.3"
                    CornerRadius="4"
                    ToolTip="{Binding CurrentUserDisplayName}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentUserOperator}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" Text="{Binding CurrentUserDisplayName}" />
                </Border>
            </StatusBarItem>

        </StatusBar>

        <kwyui:KwyToastHost
            Grid.RowSpan="2"
            Margin="12"
            MaxItems="5"
            Placement="TopRight"
            Token="RootToast" />
    </Grid>
</kwyui:KwyWindow>



