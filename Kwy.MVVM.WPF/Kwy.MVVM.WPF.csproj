<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\eng\Kwy.MVVM.Version.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
	<Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
	<ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Kwy.MVVM.WPF</PackageId>
    <Title>Kwy MVVM for WPF</Title>
    <Authors>Kwy</Authors>
    <Company>Kwy</Company>
    <Copyright>Copyright © 2026 Kwy</Copyright>
    <Description>Lightweight WPF integration for Kwy.MVVM, including application startup, dependency injection, region navigation, dialogs, view-model location, caching, and permissions.</Description>
    <PackageTags>wpf;mvvm;dotnet;navigation;dialogs;modularity;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SheriffBlack/KwyFramework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SheriffBlack/KwyFramework.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kwy.MVVM\Kwy.MVVM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE-MVVM.md" Pack="true" PackagePath="\" Link="LICENSE-MVVM.md" />
  </ItemGroup>

</Project>
