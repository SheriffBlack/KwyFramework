<UserControl
    x:Class="KwyAppDemo.Views.DataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:local="clr-namespace:KwyAppDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DataGrid
            Grid.Row="0"
            kwyui:DataGridColumnsHelper.ColumnsSource="{Binding ColumnNames}"
            kwyui:DataGridColumnsHelper.ShowRowHeaderColumn="False"
            AutoGenerateColumns="False"
            Background="{DynamicResource TransparentBrush}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            CellStyle="{StaticResource ModernBorderedDataGridCellStyle}"
            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
            GridLinesVisibility="None"
            ItemsSource="{Binding DataGridItems}"
            RowStyle="{StaticResource ModernDataGridRowStyle}"
            SelectionMode="Single"
            SelectionUnit="FullRow" />



    </Grid>
</UserControl>
