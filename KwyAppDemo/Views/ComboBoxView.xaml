<UserControl
    x:Class="KwyAppDemo.Views.ComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UniformGrid>
        <ComboBox Width="150" Height="28.4">
            <ComboBoxItem Content="xxx" />
            <ComboBoxItem Content="xxx" />
            <ComboBoxItem Content="xxx" />
        </ComboBox>
        <ComboBox
            Width="150"
            Height="28.4"
            kwyui:IconHelper.Icon="{Binding ., Converter={kwyui:IconKeyToResourceConverter}}"
            Style="{StaticResource IconComboBoxStyle}">
            <ComboBoxItem
                kwyui:IconHelper.Icon="{StaticResource IconAI}"
                Content="xxx"
                Style="{StaticResource IconComboBoxItemStyle}" />
            <ComboBoxItem
                kwyui:IconHelper.Icon="{StaticResource IconAI}"
                Content="xxx"
                Style="{StaticResource IconComboBoxItemStyle}" />
            <ComboBoxItem
                kwyui:IconHelper.Icon="{StaticResource IconAI}"
                Content="xxx"
                Style="{StaticResource IconComboBoxItemStyle}" />
        </ComboBox>

        <TextBox Width="150" Height="28.4" />
        <TextBox
            Width="150"
            Height="28.4"
            Style="{StaticResource DefaultTextBoxMultiStyle}" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Integer" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Numeric" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Full" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Integer" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Numeric" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Full" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Integer" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Numeric" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Full" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Integer" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Numeric" />
    </UniformGrid>
</UserControl>
