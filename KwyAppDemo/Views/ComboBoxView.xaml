<UserControl
    x:Class="KwyAppDemo.Views.ComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UniformGrid>
        <ComboBox Width="150" Height="28.4">
            <ComboBoxItem Content="xxx" />
            <ComboBoxItem Content="xxx" />
            <ComboBoxItem Content="xxx" />
        </ComboBox>
        <ComboBox                
            kwyui:IconHelper.Icon="{Binding ., Converter={kwyui:IconKeyToResourceConverter}}"
            Width="150"
            Height="28.4"
            Style="{StaticResource IconComboBoxStyle}">
            <ComboBoxItem Style="{StaticResource IconComboBoxItemStyle}" kwyui:IconHelper.Icon="{StaticResource IconAI}" Content="xxx" />
            <ComboBoxItem Style="{StaticResource IconComboBoxItemStyle}" kwyui:IconHelper.Icon="{StaticResource IconAI}" Content="xxx" />
            <ComboBoxItem Style="{StaticResource IconComboBoxItemStyle}" kwyui:IconHelper.Icon="{StaticResource IconAI}" Content="xxx" />
        </ComboBox>
    </UniformGrid>
</UserControl>
