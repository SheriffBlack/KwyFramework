<UserControl
    x:Class="KwyAppDemo.Views.KwyKeyboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:local="clr-namespace:KwyAppDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UniformGrid Columns="1">
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Integer" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Numeric" />
        <TextBox
            Width="150"
            Height="28.4"
            kwyui:SoftKeyboardService.IsEnabled="True"
            kwyui:SoftKeyboardService.Mode="Full" />
    </UniformGrid>
</UserControl>
