<kwyui:KwyWindow
    x:Class="KwyAppDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyflow="http://schemas.kwy.com/ui/flowdesigner"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Kwy UI Workbench"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    Icon="{StaticResource IconHome}"
    mc:Ignorable="d">

    <kwyui:KwyWindow.TitleBarContent>
        <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                Style="{StaticResource DefaultTextBlockStyle}"
                Text="WPF component preview" />
            <Rectangle Style="{StaticResource DefaultSeparatorStyle}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                Style="{StaticResource DefaultTextBlockStyle}"
                Text="Light Theme" />
        </StackPanel>
    </kwyui:KwyWindow.TitleBarContent>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20"
            Background="{DynamicResource WindowTitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="Kwy.UI.WPF" />
                    <TextBlock
                        Margin="0,4,0,24"
                        Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                        Text="Component workbench" />
                </StackPanel>

                <StackPanel>
                    <Button
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Content="Overview"
                        Style="{StaticResource DefaultButtonStyle}" />
                    <Button
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Content="Input controls"
                        Style="{StaticResource DefaultButtonStyle}" />
                    <Button
                        HorizontalContentAlignment="Left"
                        Content="Flow designer"
                        Style="{StaticResource DefaultButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="UI framework preview" />
                <TextBlock
                    Margin="0,6,0,24"
                    Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                    Text="The application explicitly loads the Kwy WPF and FlowDesigner light theme dictionaries." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Actions">
                        <StackPanel Margin="16">
                            <WrapPanel Margin="0,0,0,16">
                                <Button
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Content="Start"
                                    Foreground="{DynamicResource WhilteBrush}"
                                    Style="{StaticResource DefaultButtonStyle}" />
                                <Button
                                    Margin="0,0,12,0"
                                    Content="Pause"
                                    Style="{StaticResource DefaultButtonStyle}" />
                                <Button
                                    Content="Disabled"
                                    IsEnabled="False"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            </WrapPanel>
                            <ProgressBar
                                Height="8"
                                Maximum="100"
                                Value="72" />
                            <TextBlock
                                Margin="0,12,0,0"
                                Foreground="{DynamicResource SuccessBrush}"
                                Text="Production line connected" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Input controls">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="Station name" />
                            <TextBox
                                Grid.Column="1"
                                Padding="8,4"
                                Style="{StaticResource DefaultTextBoxStyle}"
                                Text="Assembly 01" />

                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Text="Recipe" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                SelectedIndex="0"
                                Style="{StaticResource DefaultComboBoxStyle}">
                                <ComboBoxItem Content="Standard" />
                                <ComboBoxItem Content="High speed" />
                                <ComboBoxItem Content="Maintenance" />
                            </ComboBox>

                            <TextBlock
                                Grid.Row="4"
                                VerticalAlignment="Center"
                                Text="Options" />
                            <StackPanel
                                Grid.Row="4"
                                Grid.Column="1"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,18,0"
                                    Content="Auto run"
                                    IsChecked="True" />
                                <RadioButton Content="Online" IsChecked="True" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Margin="0,24,0,0" Header="FlowDesigner canvas">
                    <Grid Height="300" Margin="1">
                        <kwyflow:KwyEditor Background="{DynamicResource KwyFlowDesignerEditorBackgroundBrush}" />
                        <TextBlock
                            Margin="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource KwyFlowDesignerNodeTextBrush}"
                            IsHitTestVisible="False"
                            Text="Node editor theme surface" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</kwyui:KwyWindow>
