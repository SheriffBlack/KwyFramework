<kwyui:KwyWindow
    x:Class="KwyAppDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Kwy UI Workbench"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    Icon="{StaticResource IconHome}"
    mc:Ignorable="d">

    <kwyui:KwyWindow.TitleBarContent>
        <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Background="{StaticResource TransparentBrush}"
                Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                Style="{StaticResource DefaultTextBlockStyle}"
                Text="WPF component preview" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Background="{StaticResource TransparentBrush}"
                Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                Style="{StaticResource DefaultTextBlockStyle}"
                Text="Light Theme" />
            <Rectangle Style="{StaticResource DefaultSeparatorStyle}" />
        </StackPanel>
    </kwyui:KwyWindow.TitleBarContent>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="Kwy.UI.WPF" />
                    <TextBlock
                        Margin="0,4,0,24"
                        Foreground="{DynamicResource WindowSecondaryForegroundBrush}"
                        Text="Component workbench" />
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding BasicControlCatalog}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{StaticResource ListBoxAccentStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,8" Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedItem.View}" />
    </Grid>
</kwyui:KwyWindow>
