<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xcth="clr-namespace:AakStudio.Shell.UI.Themes.AvalonDock;assembly=AakStudio.Shell.UI.Themes.AvalonDock">

    <Color x:Key="VisionCanvasColor">#F7F9FC</Color>
    <Color x:Key="VisionGridMajorColor">#D6DEE8</Color>
    <Color x:Key="VisionGridMinorColor">#ECF1F6</Color>
    <Color x:Key="VisionPanelColor">#FFFFFF</Color>
    <Color x:Key="VisionPanelSurfaceColor">#F9FBFD</Color>
    <Color x:Key="VisionPanelElevatedColor">#EEF4FA</Color>
    <Color x:Key="VisionPanelBorderColor">#C8D0D9</Color>
    <Color x:Key="VisionToolbarColor">#FFFFFF</Color>
    <Color x:Key="VisionTextPrimaryColor">#17202A</Color>
    <Color x:Key="VisionTextSecondaryColor">#52606D</Color>
    <Color x:Key="VisionTextMutedColor">#7A8794</Color>
    <Color x:Key="VisionAccentColor">#1976D2</Color>
    <Color x:Key="VisionAccentSoftColor">#DCEBFF</Color>
    <Color x:Key="VisionSuccessColor">#16A34A</Color>
    <Color x:Key="VisionDangerColor">#DC2626</Color>
    <Color x:Key="VisionPurpleColor">#7C3AED</Color>
    <Color x:Key="VisionHoverColor">#EFF5FB</Color>
    <Color x:Key="VisionSelectedColor">#1F1976D2</Color>
    <Color x:Key="VisionInputColor">#FFFFFF</Color>
    <Color x:Key="VisionWatermarkColor">#8A96A3</Color>

    <SolidColorBrush x:Key="CanvasBg" Color="{DynamicResource VisionCanvasColor}" />
    <SolidColorBrush x:Key="NodeBg" Color="{DynamicResource VisionPanelColor}" />
    <SolidColorBrush x:Key="NodeHeaderBg" Color="{DynamicResource VisionPanelElevatedColor}" />
    <SolidColorBrush x:Key="NodeBorderNormal" Color="{DynamicResource VisionPanelBorderColor}" />
    <SolidColorBrush x:Key="NodeBorderSel" Color="{DynamicResource VisionAccentColor}" />
    <SolidColorBrush x:Key="PortInput" Color="{DynamicResource VisionSuccessColor}" />
    <SolidColorBrush x:Key="PortOutput" Color="#D97706" />
    <SolidColorBrush x:Key="ConnColor" Color="{DynamicResource VisionAccentColor}" />
    <SolidColorBrush x:Key="FgPrimary" Color="{DynamicResource VisionTextPrimaryColor}" />
    <SolidColorBrush x:Key="FgSecondary" Color="{DynamicResource VisionTextSecondaryColor}" />
    <SolidColorBrush x:Key="FgMuted" Color="{DynamicResource VisionTextMutedColor}" />
    <SolidColorBrush x:Key="AccentBlue" Color="{DynamicResource VisionAccentColor}" />
    <SolidColorBrush x:Key="AccentGreen" Color="{DynamicResource VisionSuccessColor}" />
    <SolidColorBrush x:Key="AccentRed" Color="{DynamicResource VisionDangerColor}" />
    <SolidColorBrush x:Key="AccentPurple" Color="{DynamicResource VisionPurpleColor}" />
    <SolidColorBrush x:Key="ToolbarBg" Color="{DynamicResource VisionToolbarColor}" />

    <SolidColorBrush x:Key="VisionViewBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="VisionEditorBackgroundBrush" Color="{DynamicResource VisionCanvasColor}" />
    <SolidColorBrush x:Key="VisionGridMajorBrush" Color="{DynamicResource VisionGridMajorColor}" />
    <SolidColorBrush x:Key="VisionGridMinorBrush" Color="{DynamicResource VisionGridMinorColor}" />
    <SolidColorBrush x:Key="VisionPanelBrush" Color="{DynamicResource VisionPanelColor}" />
    <SolidColorBrush x:Key="VisionPanelSurfaceBrush" Color="{DynamicResource VisionPanelSurfaceColor}" />
    <SolidColorBrush x:Key="VisionPanelElevatedBrush" Color="{DynamicResource VisionPanelElevatedColor}" />
    <SolidColorBrush x:Key="VisionPanelBorderBrush" Color="{DynamicResource VisionPanelBorderColor}" />
    <SolidColorBrush x:Key="VisionHoverBrush" Color="{DynamicResource VisionHoverColor}" />
    <SolidColorBrush x:Key="VisionSelectedBrush" Color="{DynamicResource VisionSelectedColor}" />
    <SolidColorBrush x:Key="VisionInputBrush" Color="{DynamicResource VisionInputColor}" />
    <SolidColorBrush x:Key="VisionWatermarkBrush" Color="{DynamicResource VisionWatermarkColor}" />

    <SolidColorBrush x:Key="PaletteFg" Color="{DynamicResource VisionTextPrimaryColor}" />
    <SolidColorBrush x:Key="PaletteSubFg" Color="{DynamicResource VisionTextMutedColor}" />
    <SolidColorBrush x:Key="PaletteItemHover" Color="{DynamicResource VisionHoverColor}" />
    <SolidColorBrush x:Key="PaletteAccent" Color="{DynamicResource VisionAccentColor}" />
    <SolidColorBrush x:Key="PaletteSearchBackground" Color="{DynamicResource VisionInputColor}" />

    <xcth:VisualStudio2019Light x:Key="VisionAvalonDockTheme" />

</ResourceDictionary>
