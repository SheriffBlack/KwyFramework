<UserControl
    x:Class="KwyTemplate.Vision.Views.FlowEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:kwyflow="http://schemas.kwy.com/ui/flowdesigner"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xcp="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
    xmlns:xclayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
    xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
    xmlns:behaviors="clr-namespace:KwyTemplate.Vision.Behaviors"
    xmlns:proxy="clr-namespace:KwyTemplate.Vision.Controls"
    xmlns:converters="clr-namespace:KwyTemplate.Vision.Converters"
    xmlns:viewmodelitems="clr-namespace:KwyTemplate.Vision.ViewModels.Items"
    xmlns:views="clr-namespace:KwyTemplate.Vision.Views"
    Background="{DynamicResource VisionViewBackgroundBrush}"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding NewCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="O"
            Command="{Binding OpenCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="F5"
            Command="{Binding RunCommand}" />
        <KeyBinding
            Key="F5"
            Command="{Binding StopCommand}"
            Modifiers="Shift" />
        <KeyBinding
            Key="F5"
            Command="{Binding RunActiveGraphCommand}"
            Modifiers="Control" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KwyTemplate.Vision;component/Views/Templates/FlowEditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  ── 🏁 VisionMaster Grid Background ──  -->
            <VisualBrush
                x:Key="GridBackground"
                TileMode="Tile"
                Viewport="0,0,40,40"
                ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="40" Height="40">
                        <Rectangle Fill="{DynamicResource CanvasBg}" />
                        <!--  主网格线  -->
                        <Path
                            Data="M 40 0 L 0 0 0 40"
                            Stroke="{DynamicResource VisionGridMajorBrush}"
                            StrokeThickness="1" />
                        <!--  次网格线  -->
                        <Path
                            Data="M 20 0 L 20 40 M 0 20 L 40 20"
                            Stroke="{DynamicResource VisionGridMinorBrush}"
                            StrokeThickness="0.5" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>

            <proxy:BindingProxy x:Key="Proxy" Data="{Binding}" />

            <!--  局部数学转换器（保留在本地或移动到主程序资源）  -->
            <converters:MathConverter x:Key="MathConverter" />

            <!--  ── 📂 VS 风格的 TabItem 样式 ──  -->
            <Style x:Key="VsTabItemStyle" TargetType="TabItem">
                <Setter Property="Background" Value="{DynamicResource VisionPanelSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="12,5,8,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid x:Name="RootGrid" Height="30">
                                <Border
                                    x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                    BorderThickness="0,0,1,0">
                                    <Grid>
                                        <!--  选中态顶部的蓝色横条  -->
                                        <Border
                                            x:Name="SelectionIndicator"
                                            Height="2"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource TransparentBrush}" />

                                        <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal">
                                            <ContentPresenter
                                                x:Name="ContentSite"
                                                VerticalAlignment="Center"
                                                ContentSource="Header">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12" />
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>

                                            <!--  关闭按钮（仅在选中或鼠标悬停时较明显，模拟 VS）  -->
                                            <Button
                                                x:Name="CloseButton"
                                                Width="14"
                                                Height="14"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Opacity="0.6"
                                                Visibility="Visible">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border
                                                                        x:Name="btnBd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="2">
                                                                        <Path
                                                                            x:Name="btnPath"
                                                                            Width="7"
                                                                            Height="7"
                                                                            Data="M0,0 L7,7 M0,7 L7,0"
                                                                            Stretch="Uniform"
                                                                            Stroke="{DynamicResource FgMuted}"
                                                                            StrokeThickness="1.2" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBd" Property="Background" Value="{DynamicResource VisionHoverBrush}" />
                                                                            <Setter TargetName="btnPath" Property="Stroke" Value="{DynamicResource FgPrimary}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource VisionEditorBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
                                    <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource AccentBlue}" />
                                    <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                                    <!--  选中时去掉右侧分割线  -->
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="0" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource VisionHoverBrush}" />
                                    <Setter TargetName="CloseButton" Property="Opacity" Value="0.8" />
                                </MultiTrigger>
                                <!--  如果不是选中也不是悬浮，隐藏关闭按钮（可选，VS 通常保持显示但变淡）  -->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ── 📂 VS 风格的 TabControl 样式 ──  -->
            <Style x:Key="VsTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!--  标签页头背景  -->
                                <Border
                                    Background="{DynamicResource VisionPanelSurfaceBrush}"
                                    BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <TabPanel
                                        x:Name="HeaderPanel"
                                        Panel.ZIndex="1"
                                        IsItemsHost="True"
                                        KeyboardNavigation.TabNavigation="Once" />
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VisionToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource FgSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource VisionHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource VisionSelectedBrush}" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="VisionCanvasRunButtonStyle"
                BasedOn="{StaticResource VisionToolbarButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--  ── 📄 单个流程图的画布模板 ──  -->
            <DataTemplate DataType="{x:Type viewmodelitems:FlowGraphViewModel}">
                <Grid>
                <kwyflow:KwyEditor
                    kwyflow:KwyEditor.FitToScreenTrigger="{Binding Data.FitToScreenTriggerCount, Source={StaticResource Proxy}}"
                    AllowDrop="True"
                    behaviors:FlowEditorNodeDropBehavior.IsEnabled="True"
                    behaviors:FlowEditorNodeDropBehavior.ViewModel="{Binding Data, Source={StaticResource Proxy}}"
                    Background="{StaticResource GridBackground}"
                    ConnectionCompletedCommand="{Binding Data.ConnectCompletedCommand, Source={StaticResource Proxy}}"
                    ConnectionStartedCommand="{Binding Data.ConnectStartedCommand, Source={StaticResource Proxy}}"
                    ConnectionTemplate="{StaticResource ConnectionTemplate}"
                    Connections="{Binding Connections}"
                    DisconnectConnectorCommand="{Binding Data.DisconnectConnectorCommand, Source={StaticResource Proxy}}"
                    ItemTemplate="{StaticResource NodeTemplate}"
                    ItemsSource="{Binding Nodes}"
                    PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                    SelectedItem="{Binding Data.SelectedNode, Source={StaticResource Proxy}, Mode=TwoWay}">

                    <kwyflow:KwyEditor.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding Data.DeleteSelectionCommand, Source={StaticResource Proxy}}" />
                    </kwyflow:KwyEditor.InputBindings>

                    <kwyflow:KwyEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding Data.RunActiveGraphCommand, Source={StaticResource Proxy}}"
                                Foreground="{DynamicResource AccentGreen}"
                                Header="▶ 运行当前流程" />
                            <MenuItem
                                Command="{Binding Data.PollingRunCommand, Source={StaticResource Proxy}}"
                                Foreground="{DynamicResource AccentGreen}"
                                Header="↻ 轮询运行" />
                            <MenuItem
                                Command="{Binding Data.DebugCommand, Source={StaticResource Proxy}}"
                                Foreground="{DynamicResource AccentBlue}"
                                Header="🪲 调试" />
                            <Separator />
                            <MenuItem Command="{Binding Data.AutoLayoutCommand, Source={StaticResource Proxy}}" Header="✨ 自动排版节点" />
                            <MenuItem
                                Command="{Binding Data.FitToScreenCommand, Source={StaticResource Proxy}}"
                                Header="🔍 缩放适配"
                                ToolTip="将视角聚焦到所有节点" />
                        </ContextMenu>
                    </kwyflow:KwyEditor.ContextMenu>

                    <kwyflow:KwyEditor.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type kwyflow:KwyItemContainer}}" TargetType="{x:Type kwyflow:KwyItemContainer}">
                            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}" />
                            <Setter Property="Tag" Value="{Binding Data, Source={StaticResource Proxy}}" />
                        </Style>
                    </kwyflow:KwyEditor.ItemContainerStyle>
                </kwyflow:KwyEditor>

                    <Border
                        Margin="0,14,18,0"
                        Padding="5,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Panel.ZIndex="20">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Command="{Binding Data.RunActiveGraphCommand, Source={StaticResource Proxy}}"
                                Content="▶"
                                Foreground="{DynamicResource AccentGreen}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="运行当前流程一次" />
                            <Button
                                Command="{Binding Data.PollingRunCommand, Source={StaticResource Proxy}}"
                                Content="↻"
                                Foreground="{DynamicResource AccentGreen}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="轮询运行" />
                            <Button
                                Command="{Binding Data.DebugCommand, Source={StaticResource Proxy}}"
                                Content="⛭"
                                Foreground="{DynamicResource AccentBlue}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="调试运行" />
                            <Button
                                Command="{Binding Data.StepCommand, Source={StaticResource Proxy}}"
                                Content="⏭"
                                Foreground="{DynamicResource AccentPurple}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="单步" />
                            <Button
                                Command="{Binding Data.ContinueCommand, Source={StaticResource Proxy}}"
                                Content="▷"
                                Foreground="{DynamicResource AccentGreen}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="继续" />
                            <Button
                                Command="{Binding Data.StopCommand, Source={StaticResource Proxy}}"
                                Content="■"
                                Foreground="{DynamicResource AccentRed}"
                                Style="{StaticResource VisionCanvasRunButtonStyle}"
                                ToolTip="停止" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  ════════════════════ 主布局 ════════════════════  -->
    <AdornerDecorator>
        <Grid Background="{DynamicResource VisionViewBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ── 工具栏 ──  -->
            <Border
                Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel
                        Margin="8,0,16,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        MinWidth="170"
                        MaxWidth="320">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource FgPrimary}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBlue}"
                                Text="{Binding ProjectSaveStateText}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource FgMuted}"
                            Text="{Binding ProjectFileDisplay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button
                            Margin="2,0"
                            Padding="8,4"
                            Foreground="{DynamicResource FgPrimary}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="项目文件与流程管理">
                            <i:Interaction.Behaviors>
                                <kwyui:ClickShowContextMenuBehavior />
                            </i:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="项目" />
                                <Path
                                    Width="8"
                                    Height="4"
                                    Margin="6,2,0,0"
                                    Data="{DynamicResource DownArrowGeometry}"
                                    Fill="{DynamicResource FgPrimary}"
                                    Stretch="Fill" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding NewCommand}" Header="新建项目    Ctrl+N" />
                                    <MenuItem Command="{Binding OpenCommand}" Header="打开项目    Ctrl+O" />
                                    <Separator />
                                    <MenuItem Command="{Binding SaveCommand}" Header="保存    Ctrl+S" />
                                    <MenuItem Command="{Binding SaveAsCommand}" Header="另存为..." />
                                    <Separator />
                                    <MenuItem Command="{Binding AddGraphCommand}" Header="新增流程" />
                                    <MenuItem Command="{Binding CreateYoloSampleFlowCommand}" Header="创建示例流程：本地图像 → YOLO" />
                                    <Separator />
                                    <MenuItem Header="最近项目" ItemsSource="{Binding RecentProjects}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                                <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                                <Setter Property="Command" Value="{Binding Data.OpenRecentProjectCommand, Source={StaticResource Proxy}}" />
                                                <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Command="{Binding ClearRecentProjectsCommand}" Header="清空最近项目" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Separator />
                        <Button
                            Margin="2,0"
                            Padding="8,4"
                            Command="{Binding AutoLayoutCommand}"
                            Content="✨ 自动排版"
                            Foreground="{DynamicResource FgPrimary}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="整理所有节点的位置" />
                        <Button
                            Margin="2,0"
                            Padding="8,4"
                            Command="{Binding FitToScreenCommand}"
                            Content="🔍 缩放适配"
                            Foreground="{DynamicResource FgPrimary}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="调整放缩，使视角刚好容纳所有节点" />
                        <Button
                            Margin="2,0"
                            Padding="8,4"
                            Command="{Binding ClearCommand}"
                            Content="🗑 清空"
                            Foreground="{DynamicResource AccentRed}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="清空当前画布 (危险操作)" />

                        <Separator />
                        <Button
                            Margin="4,0,2,0"
                            Padding="12,4"
                            Command="{Binding RunCommand}"
                            Content="▶ 运行项目"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentGreen}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="按流程列表顺序运行当前项目中的全部流程" />
                        <Button
                            Margin="2,0"
                            Padding="10,4"
                            Foreground="{DynamicResource FgPrimary}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="更多运行、调试和报告操作">
                            <i:Interaction.Behaviors>
                                <kwyui:ClickShowContextMenuBehavior />
                            </i:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="运行选项" />
                                <Path
                                    Width="8"
                                    Height="4"
                                    Margin="6,2,0,0"
                                    Data="{DynamicResource DownArrowGeometry}"
                                    Fill="{DynamicResource FgPrimary}"
                                    Stretch="Fill" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding RunActiveGraphCommand}" Header="运行当前流程" />
                                    <MenuItem Command="{Binding PollingRunCommand}" Header="轮询运行当前流程" />
                                    <MenuItem Command="{Binding BatchRunCommand}" Header="批处理当前流程" />
                                    <Separator />
                                    <MenuItem Command="{Binding DebugCommand}" Header="调试当前流程" />
                                    <MenuItem Command="{Binding StepCommand}" Header="单步" />
                                    <MenuItem Command="{Binding ContinueCommand}" Header="继续" />
                                    <Separator />
                                    <MenuItem Command="{Binding ExportRunReportCommand}" Header="导出运行报告" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button
                            Margin="2,0"
                            Padding="10,4"
                            Command="{Binding StopCommand}"
                            Content="■ 停止"
                            Foreground="{DynamicResource AccentRed}"
                            Style="{StaticResource VisionToolbarButtonStyle}"
                            ToolTip="停止当前流程运行" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlue}"
                        Text="{Binding RunStatusText}" />

                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="11"
                        Foreground="{DynamicResource FgSecondary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="🔵 节点: {0}  🔗 连线: {1}">
                                <Binding Path="Nodes.Count" />
                                <Binding Path="Connections.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!--  ── 核心停靠区域 (AvalonDock) ──  -->
            <xcad:DockingManager
                x:Name="DockManager"
                Grid.Row="1"
                ActiveContent="{Binding ActiveTab, Mode=TwoWay}"
                Background="{DynamicResource VisionEditorBackgroundBrush}"
                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                BorderThickness="0"
                DocumentsSource="{Binding OpenTabs}"
                Theme="{DynamicResource VisionAvalonDockTheme}"
                Validation.ErrorTemplate="{x:Null}">

                <xcad:DockingManager.LayoutItemContainerStyle>
                    <Style TargetType="{x:Type xcp:LayoutItem}">
                        <Setter Property="Title" Value="{Binding Model.Title}" />
                        <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                    </Style>
                </xcad:DockingManager.LayoutItemContainerStyle>

                <xclayout:LayoutRoot>
                    <xclayout:LayoutPanel Orientation="Horizontal">

                        <!--  左侧：功能面板  -->
                        <xclayout:LayoutAnchorablePane DockWidth="220">
                            <!--  项目资源管理器  -->
                            <xclayout:LayoutAnchorable
                                Title="项目 (Project)"
                                CanClose="False"
                                CanFloat="True"
                                ContentId="ProjectExplorer">
                                <Grid Background="{DynamicResource VisionPanelBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Padding="10,8"
                                        Background="{DynamicResource VisionPanelBrush}"
                                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource FgPrimary}"
                                                    Text="{Binding ProjectName}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource FgMuted}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="项目流程：{0} 个">
                                                            <Binding Path="ProjectGraphs.Count" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Row="1"
                                        Padding="10,6"
                                        Background="{DynamicResource VisionEditorBackgroundBrush}"
                                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <DockPanel LastChildFill="True">
                                            <Button
                                                Width="24"
                                                MinHeight="22"
                                                Padding="0"
                                                Command="{Binding AddGraphCommand}"
                                                Content="＋"
                                                DockPanel.Dock="Right"
                                                Foreground="{DynamicResource AccentGreen}"
                                                Style="{StaticResource VisionToolbarButtonStyle}"
                                                ToolTip="新建流程" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource FgMuted}"
                                                Text="流程列表" />
                                        </DockPanel>
                                    </Border>

                                    <ListBox
                                        x:Name="ProjectGraphListBox"
                                        Grid.Row="2"
                                        AllowDrop="True"
                                        Background="{StaticResource TransparentBrush}"
                                        BorderThickness="0"
                                        ItemsSource="{Binding ProjectGraphs}"
                                        Drop="OnProjectGraphListDrop"
                                        PreviewMouseLeftButtonDown="OnProjectGraphListPreviewMouseLeftButtonDown"
                                        PreviewMouseMove="OnProjectGraphListPreviewMouseMove"
                                        SelectedItem="{Binding ActiveGraph}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border
                                                                x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VisionSelectedBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VisionHoverBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ContextMenu">
                                                    <Setter.Value>
                                                        <ContextMenu>
                                                            <MenuItem
                                                                Command="{Binding Data.SetEntryGraphCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="设为入口流程" />
                                                            <MenuItem
                                                                Command="{Binding Data.ToggleGraphDisableCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="禁用/启用流程" />
                                                            <Separator />
                                                            <MenuItem
                                                                Command="{Binding Data.DuplicateGraphCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="复制流程" />
                                                            <MenuItem
                                                                Command="{Binding Data.MoveGraphUpCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="上移" />
                                                            <MenuItem
                                                                Command="{Binding Data.MoveGraphDownCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="下移" />
                                                            <Separator />
                                                            <MenuItem
                                                                Command="{Binding Data.StartRenameGraphCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="重命名 (Rename)" />
                                                            <Separator />
                                                            <MenuItem
                                                                Command="{Binding Data.DeleteGraphCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="{DynamicResource AccentRed}"
                                                                Header="删除 (Delete)" />
                                                        </ContextMenu>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  显示状态  -->
                                                    <Grid
                                                        x:Name="DisplayArea"
                                                        Margin="8,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Margin="0,1,6,0"
                                                            Foreground="{DynamicResource FgSecondary}"
                                                            Text="▤" />
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource FgPrimary}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="6,0,0,0"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource AccentGreen}"
                                                                    Text="入口"
                                                                    Visibility="{Binding IsProjectEntry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock
                                                                    Margin="6,0,0,0"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource AccentRed}"
                                                                    Text="禁用"
                                                                    Visibility="{Binding IsDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource FgMuted}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="节点 {0} · 连线 {1} · {2} {3}">
                                                                        <Binding Path="Nodes.Count" />
                                                                        <Binding Path="Connections.Count" />
                                                                        <Binding Path="RunStatusText" />
                                                                        <Binding Path="LastElapsedText" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Width="28"
                                                            MinHeight="22"
                                                            Padding="0"
                                                            Content="⋯"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource FgSecondary}"
                                                            Style="{StaticResource VisionToolbarButtonStyle}"
                                                            ToolTip="更多流程操作">
                                                            <i:Interaction.Behaviors>
                                                                <kwyui:ClickShowContextMenuBehavior />
                                                            </i:Interaction.Behaviors>
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem
                                                                        Command="{Binding Data.SetEntryGraphCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="设为入口流程" />
                                                                    <MenuItem
                                                                        Command="{Binding Data.ToggleGraphDisableCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="禁用/启用流程" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Command="{Binding Data.DuplicateGraphCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="复制流程" />
                                                                    <MenuItem
                                                                        Command="{Binding Data.MoveGraphUpCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="上移" />
                                                                    <MenuItem
                                                                        Command="{Binding Data.MoveGraphDownCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="下移" />
                                                                    <MenuItem
                                                                        Command="{Binding Data.StartRenameGraphCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Header="重命名流程" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Command="{Binding Data.DeleteGraphCommand, Source={StaticResource Proxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Foreground="{DynamicResource AccentRed}"
                                                                        Header="删除流程" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </StackPanel>

                                                    <!--  编辑状态  -->
                                                    <TextBox
                                                        x:Name="EditArea"
                                                        Grid.ColumnSpan="2"
                                                        Margin="28,4,8,4"
                                                        Padding="0"
                                                        Background="{DynamicResource VisionInputBrush}"
                                                        BorderBrush="{DynamicResource AccentBlue}"
                                                        BorderThickness="1"
                                                        Foreground="{DynamicResource FgPrimary}"
                                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="Collapsed">
                                                        <i:Interaction.Triggers>
                                                            <i:KeyTrigger Key="Enter">
                                                                <i:InvokeCommandAction Command="{Binding Data.EndRenameGraphCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Text, ElementName=EditArea}" />
                                                            </i:KeyTrigger>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Data.EndRenameGraphCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Text, ElementName=EditArea}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter TargetName="DisplayArea" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="EditArea" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="EditArea" Property="FocusManager.FocusedElement" Value="{Binding ElementName=EditArea}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </xclayout:LayoutAnchorable>

                            <!--  节点库  -->
                            <xclayout:LayoutAnchorable
                                Title="节点库 (Palette)"
                                CanClose="False"
                                CanFloat="True"
                                ContentId="NodePalette">
                                <views:NodePaletteView DataContext="{Binding Palette}" />
                            </xclayout:LayoutAnchorable>
                        </xclayout:LayoutAnchorablePane>

                        <!--  中间：主编辑区 + 运行记录  -->
                        <xclayout:LayoutPanel Orientation="Vertical">
                            <xclayout:LayoutDocumentPane />
                            <xclayout:LayoutAnchorablePane DockHeight="150">
                                <xclayout:LayoutAnchorable
                                    Title="运行记录 (Log)"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="RunLog">
                                    <Grid Background="{DynamicResource VisionPanelBrush}">
                                        <ListBox
                                            Background="{DynamicResource VisionPanelBrush}"
                                            BorderThickness="0"
                                            kwyui:ListBoxHelper.AutoScroll="True"
                                            ItemsSource="{Binding ExecutionLogs}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgSecondary}"
                                                            Text="{Binding TimeText}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Level}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Question">
                                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="OK">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            Text="{Binding Message}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </xclayout:LayoutAnchorable>
                                <xclayout:LayoutAnchorable
                                    Title="运行结果 (Result)"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="RunResult">
                                    <Grid Background="{DynamicResource VisionPanelBrush}">
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            Background="{DynamicResource VisionPanelBrush}"
                                            BorderThickness="0"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CanUserReorderColumns="False"
                                            GridLinesVisibility="Horizontal"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding LatestNodeResults}"
                                            SelectedItem="{Binding SelectedNodeRunRecord, Mode=TwoWay}"
                                            RowHeight="28">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="70"
                                                    Binding="{Binding StatusText}"
                                                    Header="状态" />
                                                <DataGridTextColumn
                                                    Width="160"
                                                    Binding="{Binding NodeName}"
                                                    Header="节点" />
                                                <DataGridTextColumn
                                                    Width="180"
                                                    Binding="{Binding NodeType}"
                                                    Header="类型" />
                                                <DataGridTextColumn
                                                    Width="90"
                                                    Binding="{Binding ElapsedText}"
                                                    Header="耗时" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding Message}"
                                                    Header="信息" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </xclayout:LayoutAnchorable>
                                <xclayout:LayoutAnchorable
                                    Title="批处理 (Batch)"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="BatchResult">
                                    <Grid Background="{DynamicResource VisionPanelBrush}">
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            Background="{DynamicResource VisionPanelBrush}"
                                            BorderThickness="0"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CanUserReorderColumns="False"
                                            GridLinesVisibility="Horizontal"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding BatchRunRecords}"
                                            SelectedItem="{Binding SelectedBatchRunRecord, Mode=TwoWay}"
                                            RowHeight="28">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="72"
                                                    Binding="{Binding PositionText}"
                                                    Header="序号" />
                                                <DataGridTextColumn
                                                    Width="90"
                                                    Binding="{Binding Status}"
                                                    Header="结果" />
                                                <DataGridTextColumn
                                                    Width="160"
                                                    Binding="{Binding GraphName}"
                                                    Header="流程" />
                                                <DataGridTextColumn
                                                    Width="240"
                                                    Binding="{Binding SourceName}"
                                                    Header="图像源" />
                                                <DataGridTextColumn
                                                    Width="90"
                                                    Binding="{Binding ElapsedText}"
                                                    Header="耗时" />
                                                <DataGridTextColumn
                                                    Width="220"
                                                    Binding="{Binding ResultSummary}"
                                                    Header="摘要" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding Message}"
                                                    Header="信息" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </xclayout:LayoutAnchorable>
                                <xclayout:LayoutAnchorable
                                    Title="变量监控 (Variables)"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="Variables">
                                    <Grid Background="{DynamicResource VisionPanelBrush}">
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            Background="{DynamicResource VisionPanelBrush}"
                                            BorderThickness="0"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            GridLinesVisibility="Horizontal"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding RuntimeVariables}"
                                            RowHeight="28">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="150"
                                                    Binding="{Binding NodeName}"
                                                    Header="节点" />
                                                <DataGridTextColumn
                                                    Width="90"
                                                    Binding="{Binding Direction}"
                                                    Header="方向" />
                                                <DataGridTextColumn
                                                    Width="130"
                                                    Binding="{Binding PortName}"
                                                    Header="端口" />
                                                <DataGridTextColumn
                                                    Width="110"
                                                    Binding="{Binding DataType}"
                                                    Header="类型" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding DisplayValue}"
                                                    Header="值" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </xclayout:LayoutAnchorable>
                            </xclayout:LayoutAnchorablePane>
                        </xclayout:LayoutPanel>

                        <!--  右侧：图像反馈 + 属性调参  -->
                        <xclayout:LayoutAnchorablePaneGroup DockWidth="380" Orientation="Vertical">
                            <xclayout:LayoutAnchorablePane DockHeight="360">
                                <xclayout:LayoutAnchorable
                                    Title="图像/结果 (Image)"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="ImagePanel">
                                    <Grid Background="{DynamicResource VisionPanelBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Margin="6"
                                            Background="{DynamicResource VisionViewBackgroundBrush}"
                                            BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <proxy:VisionImageViewer ImageItem="{Binding SelectedImagePanelItem}" Roi="{Binding CurrentRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="6,0,6,6">
                                            <StackPanel
                                                MaxHeight="132"
                                                Margin="0,0,0,6">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RoiRegions.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <DockPanel Margin="2,0,0,4">
                                                    <StackPanel
                                                        HorizontalAlignment="Right"
                                                        DockPanel.Dock="Right"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Width="24"
                                                            MinHeight="22"
                                                            Padding="0"
                                                            Command="{Binding AddRoiRegionCommand}"
                                                            Content="+"
                                                            Foreground="{DynamicResource AccentBlue}"
                                                            Style="{StaticResource VisionToolbarButtonStyle}"
                                                            ToolTip="新增 ROI" />
                                                        <Button
                                                            Width="24"
                                                            MinHeight="22"
                                                            Padding="0"
                                                            Command="{Binding DuplicateRoiRegionCommand}"
                                                            CommandParameter="{Binding SelectedRoiRegion}"
                                                            Content="⧉"
                                                            Foreground="{DynamicResource FgSecondary}"
                                                            Style="{StaticResource VisionToolbarButtonStyle}"
                                                            ToolTip="复制当前 ROI" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource FgPrimary}"
                                                        Text="ROI 列表" />
                                                </DockPanel>
                                                <ListBox
                                                    Background="{DynamicResource VisionPanelBrush}"
                                                    BorderThickness="0"
                                                    ItemsSource="{Binding RoiRegions}"
                                                    SelectedItem="{Binding SelectedRoiRegion, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="2"
                                                                Padding="8,6"
                                                                Background="{DynamicResource VisionViewBackgroundBrush}"
                                                                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource FgPrimary}"
                                                                            Text="{Binding Name}" />
                                                                        <TextBlock
                                                                            Margin="0,2,0,0"
                                                                            FontFamily="Consolas"
                                                                            FontSize="10"
                                                                            Foreground="{DynamicResource FgSecondary}"
                                                                            Text="{Binding Summary}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal">
                                                                        <TextBlock
                                                                            Margin="0,0,6,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="10"
                                                                            Foreground="{DynamicResource AccentBlue}"
                                                                            Text="{Binding Type}" />
                                                                        <Button
                                                                            Width="22"
                                                                            MinHeight="20"
                                                                            Padding="0"
                                                                            Command="{Binding Data.ToggleRoiRegionCommand, Source={StaticResource Proxy}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="●"
                                                                            Foreground="{DynamicResource AccentGreen}"
                                                                            Style="{StaticResource VisionToolbarButtonStyle}"
                                                                            ToolTip="启用/禁用 ROI" />
                                                                        <Button
                                                                            Width="22"
                                                                            MinHeight="20"
                                                                            Padding="0"
                                                                            Command="{Binding Data.DeleteRoiRegionCommand, Source={StaticResource Proxy}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="×"
                                                                            Foreground="{DynamicResource AccentRed}"
                                                                            Style="{StaticResource VisionToolbarButtonStyle}"
                                                                            ToolTip="删除 ROI" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <ListBox
                                                Height="92"
                                                Background="{DynamicResource VisionPanelBrush}"
                                                BorderThickness="0"
                                                ScrollViewer.CanContentScroll="True"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.PanningMode="HorizontalOnly"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                ItemsSource="{Binding SelectedNodeImages}"
                                                SelectedItem="{Binding SelectedImagePanelItem, Mode=TwoWay}">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNodeImages.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedNodeImages.Count}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                                </ListBox.Style>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="2"
                                                            Padding="4"
                                                            Width="104"
                                                            Background="{DynamicResource VisionViewBackgroundBrush}"
                                                            BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <Border
                                                                Height="64"
                                                                Background="{DynamicResource VisionPanelBrush}"
                                                                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                ClipToBounds="True">
                                                                <Grid>
                                                                    <Image
                                                                        Source="{Binding ThumbnailSource}"
                                                                        Stretch="Uniform" />
                                                                    <Border
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Padding="4,1"
                                                                        Background="{DynamicResource AccentBlue}"
                                                                        CornerRadius="3,0,3,0">
                                                                        <TextBlock
                                                                            FontFamily="Consolas"
                                                                            FontSize="9"
                                                                            Foreground="White"
                                                                            Text="{Binding PositionText}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Grid>
                                </xclayout:LayoutAnchorable>
                            </xclayout:LayoutAnchorablePane>
                            <xclayout:LayoutAnchorablePane>
                                <xclayout:LayoutAnchorable
                                    Title="{Binding Data.PropertySettings.PanelTitle, Source={StaticResource Proxy}, FallbackValue='属性 (Properties)'}"
                                    CanClose="False"
                                    CanFloat="True"
                                    ContentId="PropertySettings">
                                    <views:PropertySettingsView DataContext="{Binding PropertySettings}" />
                                </xclayout:LayoutAnchorable>
                            </xclayout:LayoutAnchorablePane>
                        </xclayout:LayoutAnchorablePaneGroup>
                    </xclayout:LayoutPanel>
                </xclayout:LayoutRoot>
            </xcad:DockingManager>
        </Grid>
    </AdornerDecorator>
</UserControl>

