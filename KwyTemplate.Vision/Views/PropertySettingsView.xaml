<UserControl
    x:Class="KwyTemplate.Vision.Views.PropertySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:KwyTemplate.Vision.Converters"
    Background="{DynamicResource VisionViewBackgroundBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  用于属性面板的特定资源  -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InputTypeToVisibilityConverter x:Key="InputTypeToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Background="{DynamicResource VisionPanelBrush}"
        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
        BorderThickness="1,0,0,0">
        <ScrollViewer Background="{DynamicResource VisionPanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,15">

                <!--  📜 状态提示 (未选中任何内容)  -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                        <Condition Binding="{Binding SelectedConnections.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border
                        Margin="0,0,0,20"
                        Padding="12"
                        Background="{DynamicResource VisionPanelSurfaceBrush}"
                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentBlue}"
                                Text="全局配置 (Global)" />

                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="10"
                                Foreground="{DynamicResource FgMuted}"
                                Text="流程名称" />
                            <TextBox
                                Padding="8,5"
                                Background="{DynamicResource VisionInputBrush}"
                                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource FgPrimary}"
                                Text="{Binding GraphName, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  连线样式设置  -->
                            <TextBlock
                                Margin="0,15,0,4"
                                FontSize="10"
                                Foreground="{DynamicResource FgMuted}"
                                Text="连线样式" />
                            <ComboBox
                                Padding="8,4"
                                Background="{DynamicResource VisionInputBrush}"
                                BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                Foreground="{DynamicResource FgPrimary}"
                                SelectedIndex="{Binding ActiveGraph.ConnectionStyleIndex}">
                                <ComboBoxItem Content="曲线 (Bezier)" />
                                <ComboBoxItem Content="直线 (Straight)" />
                                <ComboBoxItem Content="折线 (Orthogonal)" />
                                <ComboBoxItem Content="电路 (Circuit)" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  选中 1 条连线的属性  -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedConnections.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedConnections.Count}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedConnections.Count}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedConnections.Count}" Value="4">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedConnections.Count}" Value="5">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ItemsControl ItemsSource="{Binding SelectedConnections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border
                                        Margin="0,0,0,15"
                                        Padding="12"
                                        Background="{DynamicResource VisionPanelSurfaceBrush}"
                                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource FgMuted}"
                                                    Text="源节点" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Source.PortColor}"
                                                    Text="{Binding Source.Node.DisplayName}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource FgMuted}"
                                                    Text="{Binding Source.Name}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="{DynamicResource FgMuted}"
                                                Text="➜" />
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource FgMuted}"
                                                    Text="目标节点" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Target.PortColor}"
                                                    Text="{Binding Target.Node.DisplayName}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource FgMuted}"
                                                    Text="{Binding Target.Name}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Margin="4,0,0,4"
                                        FontSize="10"
                                        Foreground="{DynamicResource FgMuted}"
                                        Text="实时监控" />
                                    <Border
                                        Padding="10"
                                        Background="{DynamicResource VisionInputBrush}"
                                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentGreen}"
                                            Text="{Binding LastValue, TargetNullValue='N/A'}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  选中节点的属性  -->
                <StackPanel DataContext="{Binding SelectedNode}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!--  节点参数编辑区  -->
                    <Border
                        Background="{DynamicResource VisionPanelSurfaceBrush}"
                        BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  节点概览区  -->
                            <Border
                                Padding="12"
                                Background="{DynamicResource VisionPanelElevatedBrush}"
                                BorderBrush="{DynamicResource AccentBlue}"
                                BorderThickness="4,0,0,1"
                                CornerRadius="4,4,0,0">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource FgPrimary}"
                                        Text="{Binding NodeType}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource FgSecondary}"
                                        Text="{Binding NodeDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  编辑区  -->
                            <StackPanel Grid.Row="1" Margin="12">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="10"
                                    Foreground="{DynamicResource FgMuted}"
                                    Text="实例名称" />
                                <TextBox
                                    Margin="0,0,0,12"
                                    Padding="8,5"
                                    Background="{DynamicResource VisionInputBrush}"
                                    BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource FgPrimary}"
                                    Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <!--  参数配置  -->
                                <Border
                                    Margin="0,4,0,8"
                                    Padding="0,0,0,7"
                                    BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource FgPrimary}"
                                        Text="参数配置" />
                                </Border>

                                <ItemsControl Margin="0,0,0,15" ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,2"
                                                Padding="0,5"
                                                Background="{DynamicResource TransparentBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource FgSecondary}"
                                                                Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Margin="3,0,0,0"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource AccentRed}"
                                                                Text="{Binding RequiredMark}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Margin="0,2,8,0"
                                                            FontSize="9"
                                                            Foreground="{DynamicResource FgMuted}"
                                                            Text="{Binding Description}"
                                                            TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="Text" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </Trigger>
                                                                        <Trigger Property="Text" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox
                                                            Height="28.4"
                                                            Padding="6,0"
                                                            Background="{DynamicResource VisionInputBrush}"
                                                            BorderThickness="1"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            IsReadOnly="{Binding IsReadOnly}"
                                                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=TextBox}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource VisionPanelBorderBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasRequiredError}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>

                                                        <kwyui:KwyNumberBox
                                                            Height="28.4"
                                                            Padding="6,0"
                                                            Background="{DynamicResource VisionInputBrush}"
                                                            BorderThickness="1"
                                                            DecimalPlaces="{Binding DecimalPlaces}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            IsInteger="{Binding IsInteger}"
                                                            IsReadOnly="{Binding IsReadOnly}"
                                                            Maximum="{Binding Maximum}"
                                                            Minimum="{Binding Minimum}"
                                                            SmallChange="{Binding SmallChange}"
                                                            Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=NumberBox}">
                                                            <kwyui:KwyNumberBox.Style>
                                                                <Style BasedOn="{StaticResource {x:Type kwyui:KwyNumberBox}}" TargetType="{x:Type kwyui:KwyNumberBox}">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource VisionPanelBorderBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasRequiredError}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </kwyui:KwyNumberBox.Style>
                                                        </kwyui:KwyNumberBox>

                                                        <Button
                                                            Grid.Column="1"
                                                            Width="72"
                                                            Height="28.4"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            FontSize="11"
                                                            Visibility="{Binding IsFilePathParameter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <i:Interaction.Behaviors>
                                                                <kwyui:ClickShowContextMenuBehavior />
                                                            </i:Interaction.Behaviors>
                                                            <StackPanel
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="选择" />
                                                                <Path
                                                                    Width="8"
                                                                    Height="4"
                                                                    Margin="6,1,0,0"
                                                                    Data="{DynamicResource DownArrowGeometry}"
                                                                    Fill="{DynamicResource FgPrimary}"
                                                                    Stretch="Fill" />
                                                            </StackPanel>
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Command="{Binding BrowseFileCommand}" Header="选择文件..." />
                                                                    <MenuItem Command="{Binding BrowseFolderCommand}" Header="选择文件夹..." />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>

                                                        <ComboBox
                                                            Height="28.4"
                                                            Padding="6,0"
                                                            Background="{DynamicResource VisionInputBrush}"
                                                            BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            ItemsSource="{Binding ItemsSource}"
                                                            SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=ComboBox}" />

                                                        <CheckBox
                                                            VerticalAlignment="Center"
                                                            Content="{Binding Value}"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=ToggleButton}" />

                                                        <DatePicker
                                                            Background="{DynamicResource VisionInputBrush}"
                                                            BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            SelectedDate="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=DatePicker}" />

                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            Text="{Binding Value, TargetNullValue=''}"
                                                            Visibility="{Binding InputType, Converter={StaticResource InputTypeToVisibilityConverter}, ConverterParameter=TextBlock}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource AccentRed}"
                                                            Text="{Binding RequiredErrorText}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Margin="0,5,0,4"
                                    FontSize="10"
                                    Foreground="{DynamicResource FgMuted}"
                                    Text="备注" />
                                <TextBox
                                    MinHeight="100"
                                    Padding="8,6"
                                    AcceptsReturn="True"
                                    Background="{DynamicResource VisionInputBrush}"
                                    BorderBrush="{DynamicResource VisionPanelBorderBrush}"
                                    BorderThickness="1"
                                    FontSize="11"
                                    Foreground="{DynamicResource FgSecondary}"
                                    Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
