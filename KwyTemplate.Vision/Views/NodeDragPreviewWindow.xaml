<Window
    x:Class="KwyTemplate.Vision.Views.NodeDragPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="160"
    Height="52"
    AllowsTransparency="True"
    Background="Transparent"
    IsHitTestVisible="False"
    Opacity="0.2"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    Topmost="True"
    WindowStyle="None">
    <Border
        Padding="12,0"
        Background="{DynamicResource VisionPanelBrush}"
        BorderBrush="{DynamicResource AccentBlue}"
        BorderThickness="1.5"
        CornerRadius="6"
        Opacity="0.72">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="14"
                Opacity="0.24"
                ShadowDepth="3" />
        </Border.Effect>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{DynamicResource FgPrimary}"
            Text="{Binding DisplayName}"
            TextTrimming="CharacterEllipsis" />
    </Border>
</Window>
