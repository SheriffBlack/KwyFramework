<UserControl
    x:Class="Kwy.UI.WPF.Components.Dialogs.DialogMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Kwy.UI.WPF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <kwyui:IconKeyToResourceConverter x:Key="IconKeyToResourceConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <kwymvvm:Dialog.WindowStyle>
        <Style BasedOn="{StaticResource {x:Type kwyui:KwyWindow}}" TargetType="kwyui:KwyWindow">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="kwymvvm:Dialog.WindowStartupLocation" Value="CenterScreen" />

            <Setter Property="TitleBarBackground" Value="{DynamicResource DialogTitleBarBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DialogIcon}" Value="{x:Static components:DialogMessageIcon.Success}">
                    <Setter Property="TitleBarBackground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DialogIcon}" Value="{x:Static components:DialogMessageIcon.Warning}">
                    <Setter Property="TitleBarBackground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DialogIcon}" Value="{x:Static components:DialogMessageIcon.Error}">
                    <Setter Property="TitleBarBackground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DialogIcon}" Value="{x:Static components:DialogMessageIcon.Info}">
                    <Setter Property="TitleBarBackground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DialogIcon}" Value="{x:Static components:DialogMessageIcon.Question}">
                    <Setter Property="TitleBarBackground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </kwymvvm:Dialog.WindowStyle>
    <Grid Width="460" Height="255">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--  图标区域  -->
        <ContentPresenter
            Grid.Row="0"
            Grid.Column="0"
            Width="60"
            Margin="40,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="{Binding IconResource, Converter={StaticResource IconKeyToResourceConverter}}"
            Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type system:String}">
                    <TextBlock
                        Foreground="{Binding Path=TitleBarBackground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Style="{StaticResource BtnVerticalStyleTextBlockIcon}"
                        Text="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type Geometry}">
                    <Viewbox Width="44" Height="44">
                        <Path Data="{Binding}" Fill="{Binding Path=TitleBarBackground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </Viewbox>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <!--  消息文本区域  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,20,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="16"
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <!--  按钮区域  -->
        <DockPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="20,0,20,20"
            HorizontalAlignment="Center">
            <Button
                Width="150"
                Height="40"
                Margin="0,0,40,0"
                Command="{Binding ConfirmCommand}"
                Content="确定" />
            <Button
                Width="150"
                Height="40"
                Margin="0"
                Command="{Binding CancelCommand}"
                Content="取消"
                Visibility="{Binding ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </DockPanel>
    </Grid>
</UserControl>
