<UserControl
    x:Class="Kwy.UI.WPF.Components.Logging.KwyLogListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{Binding Background, ElementName=Root}">
        <ListBox
            kwyui:ListBoxHelper.AutoScroll="{Binding AutoScroll, ElementName=Root}"
            Background="{Binding Background, ElementName=Root}"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ListBoxItemStyle}"
            ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource FgSecondary}"
                            Text="{Binding TimeText}"
                            Visibility="{Binding ShowTime, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Level}"
                            Visibility="{Binding ShowLevel, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Question">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="OK">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{DynamicResource FgPrimary}"
                            Text="{Binding Message}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="{Binding MessageTextWrapping, ElementName=Root}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>


