<UserControl
    x:Class="Kwy.UI.WPF.Components.PropertyGrid.KwyPropertyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Kwy.UI.WPF.Controls.Helpers;assembly=Kwy.UI.WPF"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:local="clr-namespace:Kwy.UI.WPF.Components.PropertyGrid"
    x:Name="Root">

    <UserControl.Resources>
        <local:GroupWidthConverter x:Key="GroupWidthConverter" />

        <Style x:Key="PropertyEditorHostStyle" TargetType="{x:Type ContentControl}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <kwyui:KwyFormItem Label="{Binding DisplayName}">
                            <TextBox
                                Width="180"
                                HorizontalAlignment="Left"
                                IsReadOnly="{Binding IsReadOnly}"
                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </kwyui:KwyFormItem>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding InputType}" Value="ComboBox">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <ComboBox
                                        Width="180"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding ItemsSource}"
                                        SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="NumberBox">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <kwyui:KwyNumberBox
                                        Width="180"
                                        HorizontalAlignment="Left"
                                        DecimalPlaces="{Binding DecimalPlaces}"
                                        IsInteger="{Binding IsInteger}"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Maximum="{Binding Maximum}"
                                        Minimum="{Binding Minimum}"
                                        SmallChange="{Binding SmallChange}"
                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="DatePicker">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <DatePicker
                                        Width="180"
                                        HorizontalAlignment="Left"
                                        SelectedDate="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="ToggleButton">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <ToggleButton
                                        HorizontalAlignment="Left"
                                        helpers:ToggleSwitchHelper.IsSwitch="True"
                                        IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="RadioButton">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <kwyui:KwyRadioButtonGroup
                                        ItemWidth="100"
                                        ItemsSource="{Binding ItemsSource}"
                                        Value="{Binding Value, Mode=TwoWay}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="TextBoxWithRadioButton">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Grid.Column="0"
                                            Width="180"
                                            HorizontalAlignment="Left"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <kwyui:KwyRadioButtonGroup
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            ItemWidth="80"
                                            ItemsSource="{Binding ItemsSource}"
                                            Value="{Binding UnitValue, Mode=TwoWay}" />
                                    </Grid>
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding InputType}" Value="TextBlock">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                    <TextBlock
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        Text="{Binding Value}" />
                                </kwyui:KwyFormItem>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ItemsControl
        Margin="{Binding Padding, ElementName=Root}"
        VerticalAlignment="Top"
        Grid.IsSharedSizeScope="True"
        ItemsSource="{Binding PropertyGroups, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <GroupBox Margin="5" Header="{Binding GroupName}">
                    <GroupBox.Width>
                        <MultiBinding Converter="{StaticResource GroupWidthConverter}" ConverterParameter="24">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            <Binding Path="WidthRatio" />
                        </MultiBinding>
                    </GroupBox.Width>

                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" Style="{StaticResource PropertyEditorHostStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
