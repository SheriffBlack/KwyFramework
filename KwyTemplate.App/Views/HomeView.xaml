<UserControl
    x:Class="KwyTemplate.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:KwyTemplate.App.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyCharts="http://schemas.kwy.com/ui/charts"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mesModels="clr-namespace:KwyTemplate.MES.Abstract.Models;assembly=KwyTemplate.MES.Abstract"
    xmlns:runtime="clr-namespace:KwyTemplate.App.Runtime"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <kwyui:StringEqualityConverter x:Key="StringEqualityConverter" />
        <Style
            x:Key="ReelScanFormItemStyle"
            BasedOn="{StaticResource {x:Type kwyui:KwyFormItem}}"
            TargetType="{x:Type kwyui:KwyFormItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReelScanState}" Value="{x:Static runtime:ReelScanState.Success}">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReelScanState}" Value="{x:Static runtime:ReelScanState.Failure}">
                    <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ReelScanTextBoxStyle"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReelScanState}" Value="{x:Static runtime:ReelScanState.Success}">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReelScanState}" Value="{x:Static runtime:ReelScanState.Failure}">
                    <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="54" />
            <Setter Property="MinWidth" Value="380" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,1,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="StationCardAccentStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardInfoBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardStationIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCameraStation}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardCameraIconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCameraStation}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardStateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StationCardStateDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="TapeParameterCellTextBlockStyle"
            BasedOn="{StaticResource DataGridCellTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  chart area  -->
        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TabControl
                    x:Name="ChartTabSelector"
                    Grid.Row="0"
                    ItemsSource="{Binding ChartTabs}"
                    SelectedIndex="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Height="0" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                            <Binding Path="ParameterId" />
                                            <Binding ElementName="ChartTabSelector" Path="SelectedItem.ParameterId" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <kwyCharts:KwyScatterTrendPlotView
                                    Title="{Binding DisplayName}"
                                    Grid.Column="0"
                                    Margin="0,4,8,0"
                                    behaviors:ChartValuePushBehavior.Limits="{Binding Limits}"
                                    behaviors:ChartValuePushBehavior.ParameterKey="{Binding ParameterId}"
                                    behaviors:ChartValuePushBehavior.Sample="{Binding LatestSample}"
                                    behaviors:ChartValuePushBehavior.Samples="{Binding Samples}"
                                    Background="{DynamicResource TransparentBrush}"
                                    SampleAxisMajorStep="50"
                                    SampleAxisTitle="{DynamicResource Home.Chart.SampleAxis}"
                                    SampleAxisViewWindow="500"
                                    UpperLimitLabel="{DynamicResource Home.Chart.UpperLimit}"
                                    LowerLimitLabel="{DynamicResource Home.Chart.LowerLimit}"
                                    TargetValueLabel="{DynamicResource Home.Chart.TargetValue}"
                                    ValueAxisTitle="{DynamicResource Home.Chart.ValueAxis}" />

                                <kwyCharts:KwyHistogramPlotView
                                    Title="{Binding DisplayName}"
                                    Grid.Column="1"
                                    Margin="8,4,0,0"
                                    behaviors:ChartValuePushBehavior.Limits="{Binding Limits}"
                                    behaviors:ChartValuePushBehavior.ParameterKey="{Binding ParameterId}"
                                    behaviors:ChartValuePushBehavior.Sample="{Binding LatestSample}"
                                    behaviors:ChartValuePushBehavior.Samples="{Binding Samples}"
                                    Background="{DynamicResource TransparentBrush}"
                                    FrequencyAxisTitle="{DynamicResource Home.Chart.FrequencyAxis}"
                                    UpperLimitLabel="{DynamicResource Home.Chart.UpperLimit}"
                                    LowerLimitLabel="{DynamicResource Home.Chart.LowerLimit}"
                                    TargetValueLabel="{DynamicResource Home.Chart.TargetValue}"
                                    MinBinWidth="0.001"
                                    ValueAxisTitle="{DynamicResource Home.Chart.ValueAxis}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>        <!--  table/station/reel area  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            MaxHeight="505">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DataGrid
                Grid.Row="0"
                Grid.Column="0"
                kwyui:DataGridColumnsHelper.ColumnsSource="{Binding PartColumns}"
                kwyui:DataGridColumnsHelper.ShowRowHeaderColumn="False"
                AlternationCount="2"
                AutoGenerateColumns="False"
                Background="{DynamicResource TransparentBrush}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                FontSize="16"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding PartRows}"
                RowStyle="{StaticResource ModernDataGridRowStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="Single" />

            <!--  tape area  -->
            <StackPanel Grid.Row="1" Grid.Column="0">

                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Text="{DynamicResource Home.Section.TapeParameters}" />
                <DataGrid
                    MinHeight="96"
                    kwyui:DataGridColumnsHelper.ColumnsSource="{Binding TapeParameterColumns}"
                    kwyui:DataGridColumnsHelper.ShowRowHeaderColumn="False"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    Background="{DynamicResource TransparentBrush}"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                    FontSize="16"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding TapeParameterRows}"
                    RowHeight="40"
                    RowStyle="{StaticResource ModernDataGridRowStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="Single" />
            </StackPanel>

            <!--  宸ヤ綅鍚敤鐘舵€?  -->
            <ItemsControl
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="10,0"
                ItemsSource="{Binding StationInstrumentItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StationCardBorderStyle}">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource StationCardAccentStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource StationCardInfoBackgroundStyle}" />

                                <Grid Grid.Column="1" Margin="18,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Path
                                        Width="26"
                                        Height="26"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconStation}"
                                        Stretch="Uniform"
                                        Style="{StaticResource StationCardStationIconStyle}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SegoeFluent}"
                                        FontSize="28"
                                        Style="{StaticResource StationCardCameraIconStyle}"
                                        Text="{StaticResource IconCamera}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        Text="{Binding StationDisplayName}" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="22,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Text="{Binding DeviceDisplayName}" />

                                <StackPanel
                                    Grid.Column="3"
                                    Margin="0,0,18,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource StationCardStateTextStyle}"
                                        Text="{Binding StateText}" />
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource StationCardStateDotStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border
                Grid.RowSpan="2"
                Grid.Column="2"
                Padding="10"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">

                <UniformGrid
                    Width="450"
                    Columns="1"
                    Grid.IsSharedSizeScope="True">
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.WorkOrder}">
                        <TextBox IsReadOnly="True" Text="{Binding WorkOrderNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.TablePaper}">
                        <TextBox IsReadOnly="True" Text="{Binding TablePaperCode, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.TopCover}">
                        <TextBox IsReadOnly="True" Text="{Binding TopCoverCode, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.ReelMatNo}" Visibility="{Binding ShowReelMatNo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox IsReadOnly="True" Text="{Binding ReelMatNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.Operator}">
                        <TextBox IsReadOnly="True" Text="{Binding OperatorNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.EquipmentNo}">
                        <TextBox IsReadOnly="True" Text="{Binding EquipmentNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.MachineType}">
                        <TextBox IsReadOnly="True" Text="{Binding MachineType, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.BarcodeContent}" Style="{StaticResource ReelScanFormItemStyle}">
                        <TextBox Style="{StaticResource ReelScanTextBoxStyle}" Text="{Binding BarcodeContent, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.ReelTpNo}" Style="{StaticResource ReelScanFormItemStyle}">
                        <TextBox Style="{StaticResource ReelScanTextBoxStyle}" Text="{Binding ReelTpNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.ReelWorkOrder}" Style="{StaticResource ReelScanFormItemStyle}">
                        <TextBox Style="{StaticResource ReelScanTextBoxStyle}" Text="{Binding ReelWorkOrderNo, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                    <kwyui:KwyFormItem Label="{DynamicResource Home.Field.ReelId}" Style="{StaticResource ReelScanFormItemStyle}">
                        <TextBox Style="{StaticResource ReelScanTextBoxStyle}" Text="{Binding ReelId, Mode=OneWay}" />
                    </kwyui:KwyFormItem>
                </UniformGrid>
            </Border>

        </Grid>



        <!--  right buttons  -->
        <StackPanel Grid.RowSpan="2" Grid.Column="1">
            <Button
                Height="60"
                Command="{Binding MesConnectionCommand}"
                Content="{Binding MesStatus.DisplayText}">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonContentHorizontalStyle}" TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
                        <Setter Property="kwyui:IconHelper.Icon" Value="{StaticResource IconEthernetError}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MesStatus.State}" Value="{x:Static mesModels:MesConnectionState.Online}">
                                <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                                <Setter Property="kwyui:IconHelper.Icon" Value="{StaticResource IconEthernet}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MesStatus.State}" Value="{x:Static mesModels:MesConnectionState.Connecting}">
                                <Setter Property="Background" Value="{DynamicResource StatusWarningBackgroundBrush}" />
                                <Setter Property="kwyui:IconHelper.Icon" Value="{StaticResource IconEthernet}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                Width="90"
                Margin="10,50,10,10"
                kwyui:IconHelper.Icon="{StaticResource IconPlay}"
                Command="{Binding StartCommand}"
                Content="{DynamicResource Home.Action.Start}"
                Style="{StaticResource ButtonContentVerticalStyle}" />
            <Button
                Width="90"
                Margin="10"
                kwyui:IconHelper.Icon="{StaticResource IconPause}"
                Command="{Binding StopCommand}"
                Content="{DynamicResource Home.Action.Stop}"
                Style="{StaticResource ButtonContentVerticalStyle}" />
            <Button
                Width="90"
                Margin="10"
                kwyui:IconHelper.Icon="{StaticResource IconScan}"
                Command="{Binding ScanReelCommand}"
                Content="{DynamicResource Home.Action.ScanReel}"
                Style="{StaticResource ButtonContentVerticalStyle}" />
        </StackPanel>

    </Grid>
</UserControl>


