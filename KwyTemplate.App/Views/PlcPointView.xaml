<UserControl
    x:Class="KwyTemplate.App.Views.PlcPointView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid>
        <GroupBox Header="{DynamicResource PlcPoint.Header.Monitor}">
            <DataGrid
                AlternationCount="2"
                AutoGenerateColumns="False"
                Background="{DynamicResource ControlBackgroundBrush}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                ItemsSource="{Binding Points}"
                RowHeight="40"
                RowStyle="{StaticResource ModernDataGridRowStyle}"
                SelectionMode="Single">
                <DataGrid.Resources>
                    <Style
                        x:Key="CenterAlignedTextBlock"
                        BasedOn="{StaticResource DataGridCellTextBlockStyle}"
                        TargetType="TextBlock">
                        <Setter Property="Margin" Value="10,0,0,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding DisplayName}"
                        ElementStyle="{StaticResource CenterAlignedTextBlock}"
                        Header="{DynamicResource PlcPoint.Column.Description}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Address}"
                        ElementStyle="{StaticResource CenterAlignedTextBlock}"
                        Header="{DynamicResource PlcPoint.Column.Address}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding DataTypeName}"
                        ElementStyle="{StaticResource CenterAlignedTextBlock}"
                        Header="{DynamicResource PlcPoint.Column.Type}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding ValueText}"
                        ElementStyle="{StaticResource CenterAlignedTextBlock}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Header="{DynamicResource PlcPoint.Column.RealTimeValue}"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Width="*" Header="{DynamicResource PlcPoint.Column.WriteControl}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid x:Name="WritePanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Width="80"
                                            Height="28.4"
                                            Margin="0,2,2,2"
                                            Command="{Binding DataContext.WriteOtherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource PlcPoint.Action.WriteOther}"
                                            IsEnabled="{Binding CanWrite}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="60"
                                            Height="28.4"
                                            Margin="0,2,2,2"
                                            Command="{Binding DataContext.WriteZeroCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource PlcPoint.Action.WriteZero}"
                                            IsEnabled="{Binding CanWrite}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="60"
                                            Height="28.4"
                                            Margin="0,2,2,2"
                                            Command="{Binding DataContext.WriteOneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource PlcPoint.Action.WriteOne}"
                                            IsEnabled="{Binding CanWrite}" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="ReadOnlyText"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource ControlSecondaryForegroundBrush}"
                                        Text="{DynamicResource PlcPoint.Text.ReadOnly}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CanWrite}" Value="False">
                                        <Setter TargetName="WritePanel" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ReadOnlyText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>



