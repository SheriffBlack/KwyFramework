<UserControl
    x:Class="KwyTemplate.App.Views.SystemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyc="http://schemas.kwy.com/ui/components"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:KwyTemplate.App.Models"
    xmlns:navigation="clr-namespace:KwyTemplate.Contracts.Navigation;assembly=KwyTemplate.Contracts"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    kwymvvm:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <kwyui:StringEqualityConverter x:Key="StringEqualityConverter" />

        <DataTemplate DataType="{x:Type models:MachineIoPointsEditorModel}">
            <DockPanel>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal" DockPanel.Dock="Top">
                    <Button Width="100" Margin="0,0,8,0" Command="{Binding AddPointCommand}" Content="新增点位" />
                    <Button Width="100" Command="{Binding RemovePointCommand}" Content="删除选中" />
                </StackPanel>
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding Points}"
                    SelectedItem="{Binding SelectedPoint, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="180" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Header="点位标识" />
                        <DataGridTextColumn Width="220" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Header="显示名称" />
                        <DataGridTextColumn Width="120" Binding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" Header="方向（Input/Output）" />
                        <DataGridTextColumn Width="120" Binding="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Header="通道" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:MachinePlcPointsEditorModel}">
            <DockPanel>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal" DockPanel.Dock="Top">
                    <Button Width="100" Margin="0,0,8,0" Command="{Binding AddPointCommand}" Content="新增点位" />
                    <Button Width="100" Command="{Binding RemovePointCommand}" Content="删除选中" />
                </StackPanel>
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding Points}"
                    SelectedItem="{Binding SelectedPoint, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="180" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Header="点位标识" />
                        <DataGridTextColumn Width="160" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Header="PLC 地址" />
                        <DataGridTextColumn Width="220" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Header="显示名称" />
                        <DataGridTextColumn Width="130" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Header="数据类型" />
                        <DataGridCheckBoxColumn Width="100" Binding="{Binding IsReadOnly, UpdateSourceTrigger=PropertyChanged}" Header="只读" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <Style
            x:Key="SecondaryNavigationButtonStyle"
            BasedOn="{StaticResource RadioButtonItemStyle}"
            TargetType="{x:Type RadioButton}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="Content" Value="{Binding DisplayText}" />
            <Setter Property="GroupName" Value="SystemNavigationGroup" />
            <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="IsChecked">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource StringEqualityConverter}" Mode="OneWay">
                        <Binding Path="DataContext.SelectedNavigationKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Path="NavigationKey" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,5"
            BorderBrush="{DynamicResource ControlBorderBrush}">
            <DockPanel LastChildFill="True">
                <Button
                    Width="120"
                    Height="35"
                    Margin="12,0,12,0"
                    HorizontalAlignment="Right"
                    Command="{Binding ApplyCommand}"
                    Content="{DynamicResource Text.Apply}"
                    DockPanel.Dock="Right">
                    <Button.Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParameterEditorVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SecondaryNavigationButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <GroupBox Header="{Binding SelectedParameterHeader}">
                <GroupBox.Style>
                    <Style BasedOn="{StaticResource {x:Type GroupBox}}" TargetType="GroupBox">
                        <Setter Property="Margin" Value="12" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParameterEditorVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <DockPanel LastChildFill="True">
                    <TextBlock
                        Margin="6,10,6,0"
                        DockPanel.Dock="Bottom"
                        Foreground="{DynamicResource ControlSecondaryForegroundBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />
                    <ScrollViewer Background="{DynamicResource TransparentBrush}" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPointEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <kwyc:KwyPropertyGrid Padding="0" Source="{Binding SelectedParameterSource}" />
                    </ScrollViewer>
                    <ContentControl Content="{Binding SelectedParameterSource}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPointEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DockPanel>
            </GroupBox>

            <ContentControl Margin="0" kwymvvm:RegionManager.RegionName="{x:Static navigation:RegionNames.SystemRegion}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParameterEditorVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
