<UserControl
    x:Class="KwyTemplate.App.Views.SystemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyc="http://schemas.kwy.com/ui/components"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    kwymvvm:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="系统配置" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Opacity="0.68"
                        Text="统一编辑设备、通信和后续业务模块的连接配置" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}"
                        Content="重载" />
                    <Button
                        MinWidth="88"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Background="{DynamicResource TransparentBrush}"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="12" ItemsSource="{Binding ConfigurationSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="0,0,0,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    Margin="0,4,0,10"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Opacity="0.68"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                                <kwyc:KwyPropertyGrid Padding="0" Source="{Binding Source}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Foreground="{DynamicResource ForegroundBrush}"
                Opacity="0.68"
                Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</UserControl>
