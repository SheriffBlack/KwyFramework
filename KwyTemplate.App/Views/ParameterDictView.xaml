<UserControl
    x:Class="KwyTemplate.App.Views.ParameterDictView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <DataGrid
            Grid.Column="0"
            kwyui:DataGridColumnsHelper.ColumnsSource="{Binding Columns}"
            kwyui:DataGridColumnsHelper.ShowRowHeaderColumn="False"
            AlternationCount="2"
            AutoGenerateColumns="False"
            Background="{DynamicResource TransparentBrush}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
            FontSize="16"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding VisibleFiles}"
            RowStyle="{StaticResource ModernDataGridRowStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionMode="Single" />

        <StackPanel Grid.Column="1" Margin="0,30,0,0">
            <kwyui:KwyFormItem Width="500" Label="{DynamicResource ParameterDict.Field.Search}">
                <ComboBox
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding VisibleFiles}"
                    SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                    Text="{Binding QueryFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextSearch.TextPath="FileName">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </kwyui:KwyFormItem>
            <Button
                Margin="200,60,0,0"
                Command="{Binding DeleteCommand}"
                Content="{DynamicResource ParameterDict.Action.Delete}" />
            <Button
                Margin="200,30,0,0"
                Command="{Binding NewCommand}"
                Content="{DynamicResource ParameterDict.Action.New}" />
            <Button
                Margin="200,30,0,0"
                Command="{Binding ImportCommand}"
                Content="{DynamicResource ParameterDict.Action.Import}" />
            <Button
                Margin="200,30,0,0"
                Content="{DynamicResource ParameterDict.Action.Export}"
                Visibility="Collapsed" />
        </StackPanel>

    </Grid>
</UserControl>
