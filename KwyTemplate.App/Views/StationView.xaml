<UserControl
    x:Class="KwyTemplate.App.Views.StationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Column="0"
            Margin="0,0,6,0"
            Header="{DynamicResource Station.Header.EnableStation}">
            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding StationItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Margin="0,70,0,0"
                            Command="{Binding DataContext.ToggleStationEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding DisplayName}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding DataContext.CanEditStationEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource CheckBoxCircleStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox
            Grid.Column="1"
            Margin="6,0,0,0"
            Grid.IsSharedSizeScope="True"
            Header="{DynamicResource Station.Header.SoftTriggerTest}">
            <ItemsControl ItemsSource="{Binding StationTestItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="30,18,50,0" Orientation="Horizontal">
                            <kwyui:KwyFormItem Label="{Binding DisplayName}">
                                <ItemsControl ItemsSource="{Binding Instruments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="180" Margin="0,0,16,0">
                                                <TextBlock
                                                    Margin="0,0,0,6"
                                                    FontWeight="Bold"
                                                    Text="{Binding TestName}" />

                                                <TextBlock Text="{DynamicResource Station.Field.RawValue}" />
                                                <TextBox
                                                    Height="28"
                                                    Margin="0,4,0,8"
                                                    IsReadOnly="True"
                                                    Text="{Binding RawValue, Mode=OneWay}" />

                                                <TextBlock Text="{DynamicResource Station.Field.NetValue}" />
                                                <TextBox
                                                    Height="28"
                                                    Margin="0,4,0,0"
                                                    IsReadOnly="True"
                                                    Text="{Binding NetValue, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </kwyui:KwyFormItem>

                            <Button
                                Margin="16,22,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding DataContext.TriggerStationInstrumentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource Station.Action.Trigger}"
                                IsEnabled="{Binding CanTrigger}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
    </Grid>
</UserControl>

