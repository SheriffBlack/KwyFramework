<UserControl
    x:Class="KwyTemplate.App.Views.DoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,12,0"
            Header="{DynamicResource Io.Do.Header.Output}">
            <ItemsControl ItemsSource="{Binding OutPutPoints}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6">
                            <Button
                                Width="Auto"
                                Height="42"
                                Padding="8,0"
                                Command="{Binding DataContext.IoTriggerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Name}"
                                FontSize="15"
                                ToolTip="{Binding Name}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding TriggerCount}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="{DynamicResource Io.Header.SignalSettings}">
            <StackPanel Margin="8" Grid.IsSharedSizeScope="True">
                <kwyui:KwyFormItem Label="{DynamicResource Io.Field.Count}">
                    <Button
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearCountCommand}"
                        Content="{DynamicResource Io.Action.ClearCount}" />
                </kwyui:KwyFormItem>

                <kwyui:KwyFormItem Label="{DynamicResource Io.Field.Reverse}">
                    <ToggleButton
                        HorizontalAlignment="Left"
                        IsChecked="{Binding IsReverseChecked, Mode=TwoWay}"
                        Style="{StaticResource ToggleButtonSwitchNoContentStyle}" />
                </kwyui:KwyFormItem>

                <kwyui:KwyFormItem Label="{DynamicResource Io.Field.Duration}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="86" Text="{Binding DurationValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                            <RadioButton
                                VerticalAlignment="Center"
                                Content="ms"
                                GroupName="DoDurationUnit"
                                IsChecked="{Binding IsMillisecondsMode, Mode=TwoWay}" />
                            <RadioButton
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="s"
                                GroupName="DoDurationUnit"
                                IsChecked="{Binding IsSecondsMode, Mode=TwoWay}" />
                            <RadioButton
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="{DynamicResource Io.Duration.Hold}"
                                GroupName="DoDurationUnit"
                                IsChecked="{Binding IsHoldMode, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </kwyui:KwyFormItem>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>

