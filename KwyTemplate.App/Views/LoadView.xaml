<UserControl
    x:Class="KwyTemplate.App.Views.LoadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    kwymvvm:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LoadTitleBrush" Color="#050B12" />
        <SolidColorBrush x:Key="LoadBodyBrush" Color="#111A20" />
        <SolidColorBrush x:Key="LoadMutedBrush" Color="#2F3A3D" />
        <SolidColorBrush x:Key="LoadAccentBrush" Color="#008000" />
        <SolidColorBrush x:Key="LoadProgressTrackBrush" Color="#CAD8CE" />
        <SolidColorBrush x:Key="LoadFooterBrush" Color="#8B908D" />
        <SolidColorBrush x:Key="LoadFooterTextBrush" Color="#111111" />
    </UserControl.Resources>
    <kwymvvm:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="kwymvvm:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </kwymvvm:Dialog.WindowStyle>

    <Grid Width="1000" Height="620">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="86" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ClipToBounds="True">
            <Border Background="#EFF1EE" />

            <Image
                HorizontalAlignment="Right"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{StaticResource ImgLoad}"
                Stretch="UniformToFill">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.32" Color="#55FFFFFF" />
                        <GradientStop Offset="1" Color="#FFFFFFFF" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#F6F7F4" />
                        <GradientStop Offset="0.42" Color="#DDF6F7F4" />
                        <GradientStop Offset="0.78" Color="#55F6F7F4" />
                        <GradientStop Offset="1" Color="#00F6F7F4" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Height="120" VerticalAlignment="Bottom">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#00EFF1EE" />
                        <GradientStop Offset="1" Color="#DDEFF1EE" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Margin="50,46,30,0" VerticalAlignment="Top">
                <TextBlock
                    FontSize="59"
                    FontWeight="Light"
                    Foreground="{StaticResource LoadTitleBrush}"
                    Text="&#x9AD8;&#x901F; &amp; &#x6D4B;&#x5305;&#x7CFB;&#x7EDF;" />
                <TextBlock
                    Margin="2,-4,0,0"
                    FontSize="32"
                    FontWeight="Light"
                    Foreground="{StaticResource LoadBodyBrush}"
                    Text="High-Speed Test &amp; Taping Platform" />
                <Border
                    Margin="0,8,0,0"
                    Padding="7,1,8,2"
                    HorizontalAlignment="Left"
                    Background="{StaticResource LoadAccentBrush}"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="36"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource WhilteBrush}"
                        Text="v3.0.1" />
                </Border>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <DockPanel Margin="50,0,30,7" LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="20"
                        Foreground="{StaticResource LoadBodyBrush}"
                        Text="{Binding StartupProgress.CurrentItem}" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontSize="20"
                        Foreground="{StaticResource LoadBodyBrush}"
                        Text="{Binding StartupProgress.PercentText}" />
                </DockPanel>
                <ProgressBar
                    Height="7"
                    Background="{StaticResource LoadProgressTrackBrush}"
                    Foreground="{StaticResource LoadAccentBrush}"
                    Value="{Binding StartupProgress.ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource LoadFooterBrush}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Height="42"
                Margin="50,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderThickness="0"
                Visibility="Collapsed">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource ImgInfoHsy}" />
            </Border>

            <DockPanel
                Grid.Row="1"
                Margin="50,0,30,10"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Left"
                    FontSize="11"
                    Foreground="{StaticResource LoadFooterTextBrush}"
                    Text="{Binding OfficialUrl}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource LoadFooterTextBrush}"
                    Opacity="0.35"
                    Text="{Binding CopyrightText}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
