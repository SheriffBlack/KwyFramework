<UserControl
    x:Class="KwyTemplate.App.Views.DiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kwycontrols="clr-namespace:Kwy.UI.WPF.Controls;assembly=Kwy.UI.WPF"
    xmlns:kwyui="http://schemas.kwy.com/ui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DiCardStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ConnectBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ConnectBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoPointNameTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,12,0"
            Header="{DynamicResource Io.Di.Header.InputMonitor}">
            <ItemsControl ItemsSource="{Binding InPutPoints}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6">
                            <Border Style="{StaticResource DiCardStyle}">
                                <TextBlock
                                    Style="{StaticResource IoPointNameTextStyle}"
                                    Text="{Binding Name}"
                                    ToolTip="{Binding Name}" />
                            </Border>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding TriggerCount}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Header="{DynamicResource Io.Header.SignalSettings}">
            <StackPanel Margin="8" Grid.IsSharedSizeScope="True">
                <kwycontrols:KwyFormItem Label="{DynamicResource Io.Field.Count}">
                    <Button
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearCountCommand}"
                        Content="{DynamicResource Io.Action.ClearCount}" />
                </kwycontrols:KwyFormItem>

                <kwycontrols:KwyFormItem Label="{DynamicResource Io.Field.InputReverse}">
                    <ToggleButton
                        HorizontalAlignment="Left"
                        IsChecked="{Binding IsReverseChecked, Mode=TwoWay}"
                        Style="{StaticResource ToggleButtonSwitchNoContentStyle}" />
                </kwycontrols:KwyFormItem>

                <TextBlock
                    Margin="4,18,4,0"
                    Foreground="{DynamicResource ControlSecondaryForegroundBrush}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,12,0,0"
            Header="{DynamicResource Io.Di.Header.LogicMonitor}">
            <Border
                MinHeight="90"
                Padding="14"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    Foreground="{DynamicResource ControlSecondaryForegroundBrush}"
                    Text="{DynamicResource Io.Di.Description.LogicMonitor}"
                    TextWrapping="Wrap" />
            </Border>
        </GroupBox>
    </Grid>
</UserControl>


