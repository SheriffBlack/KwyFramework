<UserControl
    x:Class="KwyTemplate.App.Dialogs.CameraStartupOptionsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kwymvvm="http://schemas.kwy.com/mvvm"
    xmlns:kwyui="http://schemas.kwy.com/ui">
    <kwymvvm:Dialog.WindowStyle>
        <Style BasedOn="{StaticResource {x:Type kwyui:KwyWindow}}" TargetType="kwyui:KwyWindow">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="Title" Value="{Binding Title}" />
            <Setter Property="kwymvvm:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </kwymvvm:Dialog.WindowStyle>
    <Grid Width="460" MinHeight="255">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="40,28,40,18">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Margin="0,18,0,20" Text="{Binding Message}" TextWrapping="Wrap" />
            <CheckBox Style="{StaticResource CheckBoxCircleStyle}" Margin="0,0,0,14" Content="{Binding CameraALabel}" IsChecked="{Binding IsCameraAEnabled, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource CheckBoxCircleStyle}" Content="{Binding CameraBLabel}" IsChecked="{Binding IsCameraBEnabled, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,40,26" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="120" Height="40" Margin="0,0,12,0" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmButtonText}" IsDefault="True" />
            <Button Width="120" Height="40" Command="{Binding CancelCommand}" Content="{Binding CancelButtonText}" IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
